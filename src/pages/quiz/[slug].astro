---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Base from '../../layouts/Base.astro'
import Quiz from '../../components/Quiz.astro'
import UniverseGrid from '../../components/UniverseGrid.astro'
import CtaBand from '../../components/CtaBand.astro'
import Faq from '../../components/Faq.astro'
import quizData from '../../data/quiz-fr.json'
import { SITE, UNIVERSES, type Universe } from '../../data/product'
import { breadcrumbs, faqPage, webPage, APP_ID } from '../../data/schema'

export function getStaticPaths() {
  return UNIVERSES.map((u) => ({ params: { slug: u.slug }, props: { universe: u } }))
}

interface Props { universe: Universe }
const { universe: u } = Astro.props
const data = quizData as { questions: Record<string, { q: string; a: string; d: string[] }[]>; counts: Record<string, number> }
const questions = data.questions[u.id] ?? []
// Arrondi à la dizaine inférieure : reste vrai quand le contenu évolue.
const appCount = Math.floor((data.counts[u.id] ?? 0) / 10) * 10
const art = import.meta.glob<{ default: ImageMetadata }>('../../assets/universes/*.png', { eager: true })
const img = art[`../../assets/universes/${u.id.replaceAll('_', '-')}.png`]?.default

const name = u.fr
const path = `/quiz/${u.slug}/`
const title = `Quiz ${name} : 5 questions pour tester ta culture`
const description = `Quiz ${name} gratuit en 5 questions, sans inscription. Teste ta culture puis défie tes amis : plus de ${appCount} questions dans l'app Shobukan.`
const faq = [
  { q: `Combien de questions compte ce quiz ${name} ?`, a: `Ce quiz ${name} compte 5 questions à choix multiple, de facile à moyen. L'app Shobukan en propose plus de ${appCount} sur ${name}, plus 17 autres univers manga.` },
  { q: `Peut-on jouer au quiz ${name} entre amis ?`, a: `Oui. Dans l'app Shobukan, le quiz se joue seul, à plusieurs sur un même téléphone ou en ligne jusqu'à 12 joueurs, chacun sur son téléphone avec un code de partie.` },
  { q: 'Le quiz est-il gratuit ?', a: "Oui, ce quiz est gratuit et sans inscription. L'app Shobukan est aussi gratuite sur iPhone et Android, avec des publicités." },
]
const jsonLd = [
  webPage(path, title, 'fr'),
  breadcrumbs([
    { name: 'Shobukan', path: '/' },
    { name: 'Quiz manga', path: '/quiz/' },
    { name: `Quiz ${name}`, path },
  ]),
  {
    '@type': 'Quiz',
    '@id': `${SITE}${path}#quiz`,
    name: `Quiz ${name}`,
    inLanguage: 'fr',
    about: { '@type': 'CreativeWork', name },
    provider: { '@id': APP_ID },
    hasPart: questions.map((qu) => ({
      '@type': 'Question',
      eduQuestionType: 'Multiple choice',
      text: qu.q,
      acceptedAnswer: { '@type': 'Answer', text: qu.a },
      suggestedAnswer: qu.d.map((t) => ({ '@type': 'Answer', text: t })),
    })),
  },
  faqPage(`${SITE}${path}#faq`, faq),
]
const style = `--c1:${u.colors[0]};--c2:${u.colors[1]};--c3:${u.colors[2]}`
---

<Base lang="fr" title={title} description={description} path={path} alternates={{ fr: path, en: null }} jsonLd={jsonLd}>
  <section class="qhero" style={style}>
    <div class="halftone dots" aria-hidden="true"></div>
    <div class="wrap qhero-grid">
      <div>
        <nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Shobukan</a> / <a href="/quiz/">Quiz manga</a> / <span>{name}</span></nav>
        <h1 class="display">Quiz {name}</h1>
        <p class="lede">
          <strong>Ce quiz {name} gratuit compte 5 questions à choix multiple, sans inscription.</strong>{' '}
          Réponds directement ci-dessous, puis défie tes amis : l'app Shobukan en contient plus de {appCount} sur {name}.
        </p>
      </div>
      {img && <Image class="uart" src={img} alt="" width={360} loading="eager" />}
    </div>
  </section>

  <section class="section quiz-section">
    <div class="wrap narrow">
      <Quiz lang="fr" questions={questions} universeName={name} appCount={appCount} medium={`quiz_${u.slug}`} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Encore plus de quiz</p>
        <h2 class="display">Un autre manga ?</h2>
      </div>
      <UniverseGrid lang="fr" linkToQuiz exclude={u.id} />
    </div>
  </section>

  <Faq items={faq} title={`Le quiz ${name} en bref`} />
  <CtaBand lang="fr" medium={`quiz_${u.slug}_footer`} title={`Plus de ${appCount} questions ${name} t’attendent.`} body="Joue seul pour monter en grade, ou lance une partie avec tes amis sur un seul téléphone ou en ligne." />
</Base>

<style>
  .qhero {
    position: relative; overflow: hidden;
    padding: clamp(36px, 7vw, 80px) 0 clamp(40px, 7vw, 72px);
    background:
      radial-gradient(60% 90% at 85% 30%, color-mix(in srgb, var(--c2) 55%, transparent), transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--c3) 35%, var(--bg)), var(--bg));
  }
  .dots { position: absolute; inset: 0; opacity: 0.7; mask-image: linear-gradient(180deg, #000, transparent); }
  .qhero-grid { position: relative; display: grid; gap: 24px; align-items: center; }
  @media (min-width: 820px) { .qhero-grid { grid-template-columns: 1.5fr 1fr; } }
  .crumbs { font-size: 14px; color: var(--muted); margin-bottom: 18px; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--text); }
  .crumbs span { color: var(--text); }
  .uart { width: min(300px, 60vw); height: auto; justify-self: center; filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.5)); transform: rotate(-6deg); }
  @media (max-width: 819px) { .uart { width: 150px; justify-self: start; order: -1; } }
  .quiz-section { padding-top: 8px; }
  .narrow { max-width: 820px; }
</style>
