---
import { PRICES, UNIVERSES, formatPrice, type Lang } from '../data/product'
import { ROUTES } from '../i18n/ui'

interface Props { lang: Lang; showDetailsLink?: boolean }
const { lang, showDetailsLink = true } = Astro.props
const fr = lang === 'fr'
const p = (v: number) => formatPrice(v, lang)

const c = fr
  ? {
      monthly: 'Mensuel', yearly: 'Annuel', save: '-25 %',
      free: { name: 'Gratuit', price: p(0), sub: 'Pour toujours', items: ['Tous les modes', `Les ${UNIVERSES.length} univers manga`, 'Parties sur un téléphone illimitées', 'Rejoindre en ligne sans limite', `${PRICES.freeHostedGames} parties en ligne hébergées`, 'Avec publicités'], cta: 'Jouer gratuitement' },
      premium: { name: 'Premium', badge: 'Recommandé', perMonth: '/mois', perYear: '/an', yearlyNote: `soit ${p(PRICES.yearlyPerMonth)} par mois`, monthlyNote: 'Sans engagement', items: ['Zéro pub, pour toute la table', 'Parties en ligne illimitées', 'Vies illimitées en Expédition', '1 crédit créateur inclus', 'Accès anticipé aux nouveautés'], cta: 'Passer Premium' },
      credit: { name: 'Crédit créateur', price: p(PRICES.creatorCredit), per: '/pack', sub: 'À l’unité', items: ['Crée ton propre pack', 'Tes questions ou tes mots', 'Jouable gratuitement par tous', 'Achat unique, sans abonnement'], cta: 'Créer un pack' },
      trust: ['Sans engagement', 'Résiliable à tout moment', 'Mêmes prix sur iPhone et Android', 'Rejoindre une partie est gratuit'],
      details: 'Détail complet des prix',
      note: 'Prix de référence en France. Le store affiche le prix exact dans ta devise avant l’achat.',
    }
  : {
      monthly: 'Monthly', yearly: 'Yearly', save: '-25%',
      free: { name: 'Free', price: p(0), sub: 'Forever', items: ['Every mode', `All ${UNIVERSES.length} manga universes`, 'Unlimited same-phone games', 'Join online without limit', `Host ${PRICES.freeHostedGames} online games`, 'With ads'], cta: 'Play for free' },
      premium: { name: 'Premium', badge: 'Recommended', perMonth: '/month', perYear: '/year', yearlyNote: `that's ${p(PRICES.yearlyPerMonth)} per month`, monthlyNote: 'No commitment', items: ['No ads, for the whole table', 'Unlimited online games', 'Unlimited Expedition lives', '1 creator credit included', 'Early access to new content'], cta: 'Go Premium' },
      credit: { name: 'Creator credit', price: p(PRICES.creatorCredit), per: '/pack', sub: 'Pay per pack', items: ['Create your own pack', 'Your questions or words', 'Free for everyone to play', 'One-off, no subscription'], cta: 'Create a pack' },
      trust: ['No commitment', 'Cancel anytime', 'Same price on iPhone and Android', 'Joining a game is free'],
      details: 'Full pricing details',
      note: 'Reference prices in France. The store shows the exact price in your currency before you buy.',
    }
---

<div class="pricing" data-plan="yearly">
  <div class="toggle" role="group" aria-label={fr ? 'Période de facturation' : 'Billing period'}>
    <button type="button" data-set="monthly">{c.monthly}</button>
    <button type="button" data-set="yearly" aria-pressed="true">{c.yearly} <span class="save">{c.save}</span></button>
  </div>

  <div class="plans">
    <div class="card plan">
      <h3>{c.free.name}</h3>
      <p class="price"><b>{c.free.price}</b></p>
      <p class="sub">{c.free.sub}</p>
      <ul class="check">{c.free.items.map((i) => <li>{i}</li>)}</ul>
      <a class="btn btn-ghost plan-cta" href="#download">{c.free.cta}</a>
    </div>
    <div class="card plan hl">
      <span class="tag ribbon">{c.premium.badge}</span>
      <h3>{c.premium.name}</h3>
      <p class="price">
        <b class="y">{p(PRICES.yearly)}</b><b class="m">{p(PRICES.monthly)}</b>
        <span class="y">{c.premium.perYear}</span><span class="m">{c.premium.perMonth}</span>
      </p>
      <p class="sub"><span class="y">{c.premium.yearlyNote}</span><span class="m">{c.premium.monthlyNote}</span></p>
      <ul class="check">{c.premium.items.map((i) => <li>{i}</li>)}</ul>
      <a class="btn btn-primary plan-cta" href="#download">{c.premium.cta}</a>
    </div>
    <div class="card plan">
      <h3>{c.credit.name}</h3>
      <p class="price"><b>{c.credit.price}</b> <span>{c.credit.per}</span></p>
      <p class="sub">{c.credit.sub}</p>
      <ul class="check">{c.credit.items.map((i) => <li>{i}</li>)}</ul>
      <a class="btn btn-ghost plan-cta" href="#download">{c.credit.cta}</a>
    </div>
  </div>

  <ul class="trust">{c.trust.map((tr) => <li>{tr}</li>)}</ul>
  <p class="foot">
    {showDetailsLink && <a href={ROUTES.pricing[lang]}>{c.details} →</a>}
    <span>{c.note}</span>
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.pricing').forEach((box) => {
    const btns = box.querySelectorAll<HTMLButtonElement>('.toggle button')
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        box.dataset.plan = b.dataset.set
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
      }),
    )
  })
</script>

<style>
  .toggle { display: inline-flex; gap: 4px; padding: 4px; background: var(--surface); border: 1px solid var(--border-strong); border-radius: 999px; }
  .toggle button { font: inherit; font-weight: 600; font-size: 14px; border: 0; cursor: pointer; padding: 8px 16px; border-radius: 999px; background: transparent; color: var(--muted); }
  .toggle button[aria-pressed='true'] { background: var(--accent); color: #fff; }
  .save { font-size: 11px; font-weight: 800; color: #120609; background: var(--gold); border-radius: 999px; padding: 1px 6px; margin-left: 4px; }

  .plans { display: grid; gap: 12px; margin-top: 18px; }
  @media (min-width: 860px) { .plans { grid-template-columns: repeat(3, 1fr); gap: 16px; } }
  .plan { position: relative; padding: 24px 22px 22px; display: flex; flex-direction: column; }
  .plan.hl {
    border-color: rgba(255, 51, 72, 0.6);
    background:
      radial-gradient(120% 70% at 50% 0%, var(--brand-subtle), transparent 70%),
      radial-gradient(rgba(255, 246, 230, 0.05) 1px, transparent 1.4px) 0 0 / 12px 12px,
      var(--surface-2);
    box-shadow: 0 20px 50px rgba(255, 51, 72, 0.14), var(--elev-1);
  }
  .ribbon { position: absolute; right: 18px; top: 20px; }
  .plan h3 { font-family: var(--font-display); font-weight: 800; font-size: 18px; }
  .price { margin: 12px 0 0; display: flex; align-items: baseline; gap: 6px; }
  .price b { font-family: var(--font-display); font-weight: 800; font-size: clamp(38px, 4vw, 48px); letter-spacing: -0.04em; line-height: 1; }
  .price span { color: var(--muted); }
  .sub { margin: 6px 0 0; color: var(--gold); font-size: 14px; font-weight: 600; }
  .plan .check { margin: 18px 0 22px; flex: 1; }
  .plan-cta { width: 100%; }
  .pricing[data-plan='yearly'] .m, .pricing[data-plan='monthly'] .y { display: none; }

  .trust { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; color: var(--muted); font-size: 14px; }
  .trust li { display: inline-flex; align-items: center; gap: 8px; }
  .trust li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .foot { margin: 10px 0 0; font-size: 13px; color: var(--faint); display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .foot a { color: var(--text); font-weight: 600; font-size: 14px; text-decoration: none; }
</style>
