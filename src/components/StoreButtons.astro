---
// Badges officiels App Store et Google Play. Si un badge existe dans la langue
// de la page (src/assets/badges/<store>-<lang>.svg), il est utilisé ; sinon
// on prend la version anglaise.
import type { ImageMetadata } from 'astro'
import { androidLink, iosLink, type Lang } from '../data/product'
import { t } from '../i18n/ui'

interface Props {
  lang: Lang
  /** Identifie la page/le bouton dans les stats Google Play (utm_medium). */
  medium: string
  note?: boolean
  center?: boolean
}
const { lang, medium, note = true, center = false } = Astro.props
const ui = t(lang).stores
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/badges/*.svg', { eager: true })
const badge = (store: string) => (files[`../assets/badges/${store}-${lang}.svg`] ?? files[`../assets/badges/${store}-en.svg`])!.default
const apple = badge('app-store')
const google = badge('google-play')
---

<div class:list={['stores', { center }]}>
  <div class="row">
    <a class="store" href={iosLink(lang)} data-store="ios">
      <img src={apple.src} width={apple.width} height={apple.height} alt={`${ui.iosSmall} ${ui.iosBig}`.replace("l' ", "l'")} />
    </a>
    <a class="store" href={androidLink(medium)} data-store="android">
      <img src={google.src} width={google.width} height={google.height} alt={`${ui.androidSmall} ${ui.androidBig}`} />
    </a>
    <slot />
  </div>
  {note && <p class="note">{ui.note}</p>}
</div>

<style>
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .center .row { justify-content: center; }
  .store { display: inline-block; line-height: 0; border-radius: 9px; transition: transform 0.15s ease, filter 0.15s ease; }
  .store:hover { transform: translateY(-2px); filter: drop-shadow(0 10px 22px rgba(255, 51, 72, 0.35)); }
  .store img { height: 54px; width: auto; }
  .note { font-size: 13px; color: var(--muted); margin: 14px 0 0; }
  .center .note { text-align: center; }
  @media (max-width: 420px) { .store img { height: 48px; } }
</style>
