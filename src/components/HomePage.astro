---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Base from '../layouts/Base.astro'
import StoreButtons from './StoreButtons.astro'
import QuickQuestion from './QuickQuestion.astro'
import PricingPanel from './PricingPanel.astro'
import Faq from './Faq.astro'
import CtaBand from './CtaBand.astro'
import icon from '../assets/art/icon.png'
import undercoverBg from '../assets/art/undercover-game-bg.jpg'
import quizArt from '../assets/art/otaku-quiz.jpg'
import undercoverArt from '../assets/art/undercover.jpg'
import gridMark from '../assets/art/anime-grid-mark.png'
import village from '../assets/art/campaign-village.jpg'
import shinobi from '../assets/art/shobukan-shinobi-back.png'
import quizFr from '../data/quiz-fr.json'
import quizEn from '../data/quiz-en.json'
import { CONTENT, PLAYERS, PRICES, SITE, UNIVERSES, formatPrice, quizPath, universeName, type Lang } from '../data/product'
import { ROUTES } from '../i18n/ui'
import { app, faqPage, organization, website } from '../data/schema'

interface Props { lang: Lang }
const { lang } = Astro.props
const fr = lang === 'fr'
const p = (v: number) => formatPrice(v, lang)
const nf = new Intl.NumberFormat(fr ? 'fr-FR' : 'en-US')
const universeList = UNIVERSES.map((u) => universeName(u, lang)).join(', ')
const counts = ((fr ? quizFr : quizEn) as { counts: Record<string, number> }).counts
const art = import.meta.glob<{ default: ImageMetadata }>('../assets/universes/*.png', { eager: true })
const artFor = (id: string) => art[`../assets/universes/${id.replaceAll('_', '-')}.png`]?.default
const byId = (id: string) => UNIVERSES.find((u) => u.id === id)!
const fanLeft = ['naruto', 'one_piece', 'jujutsu_kaisen'].map(byId)
const fanRight = ['demon_slayer', 'dragon_ball', 'chainsaw_man'].map(byId)

const c = fr
  ? {
      title: 'Shobukan : quiz manga et Undercover anime entre amis',
      description: 'Jeu mobile gratuit de soirée sur le manga (iPhone, Android) : Undercover, Otaku Quiz, Anime Grid du jour. Sur un seul téléphone ou en ligne avec un code.',
      h1a: 'Party game', h1b: 'manga',
      lede: `Shobukan est un jeu mobile gratuit de soirée sur le thème du manga. Undercover, quiz et défis quotidiens sur ${UNIVERSES.length} univers.`,
      lede2: 'Sur un seul téléphone, même sans réseau, ou en ligne avec tes potes.',
      qLabel: 'questions',
      ucA: "Ce soir, l'un de vous", ucB: 'ment.',
      ucList: ['Chacun reçoit un mot secret tiré d’un manga', "L'infiltré a un mot proche… et ne le sait pas", 'Un indice chacun, un vote, un démasqué'],
      ucCta: 'Les règles du jeu', ucChip: `${PLAYERS.undercoverMin} à ${PLAYERS.undercoverMax} joueurs · en ligne ou même téléphone`,
      tiles: [
        { t: 'Otaku Quiz', s: `Solo ou jusqu'à ${PLAYERS.quizMax} joueurs`, img: 'quiz' },
        { t: 'Anime Grid', s: 'Une grille par jour, un classement', img: 'grid', tag: 'Chaque jour' },
        { t: 'Expédition', s: 'L’aventure solo en chapitres', img: 'shinobi' },
        { t: 'Packs perso', s: 'Tes questions, tes mots, ton groupe', svg: 'M12 5v14M5 12h14' },
        { t: 'Hors ligne', s: 'Un seul téléphone, sans réseau', svg: 'M7 3h10a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm4 15h2' },
        { t: 'En ligne', s: 'Un code à 6 caractères suffit', svg: 'M9 15 15 9M8 12l-2 2a3 3 0 0 0 4 4l2-2m4-4 2-2a3 3 0 0 0-4-4l-2 2' },
      ],
      shows: [
        { a: 'Otaku', b: 'Quiz', capT: 'Le quiz qui met fin aux débats', capS: `${nf.format(CONTENT.questions.fr)}+ questions, seul ou jusqu'à ${PLAYERS.quizMax} joueurs.`, href: ROUTES.quiz.fr },
        { a: 'Anime', b: 'Grid', capT: 'Une grille par jour', capS: 'Plus ta réponse est rare, plus tu grimpes au classement.' },
        { a: 'Expédition', b: 'solo', capT: 'Ta culture est ta seule arme', capS: 'Une aventure solo, de chapitre en chapitre.' },
      ],
      rare: ['Ultra rare', 'Rare', 'Commun'],
      storyTitleA: 'Ta soirée', storyTitleB: 'Undercover', storySub: `${CONTENT.wordPairs.fr}+ paires de mots, ${UNIVERSES.length} univers`,
      steps: [
        { n: '01', t: 'Un seul téléphone sur la table', s: 'Ou chacun le sien, en ligne' },
        { n: '02', t: 'Chacun découvre son mot', s: 'Kakashi Hatake… ou Itachi Uchiha ?' },
        { n: '03', t: 'Un indice chacun', s: '« Cheveux blancs. » « Il lit beaucoup. »' },
        { n: '04', t: 'Le vote tombe', s: "L'infiltré était ton meilleur pote" },
      ],
      quizTitleA: 'Tes quiz', quizTitleB: 'manga', quizSub: `${UNIVERSES.length} quiz gratuits sur le site, sans inscription`,
      quizCta: 'Voir les 18 quiz',
      priceTitleA: 'Gratuit.', priceTitleB: 'Pour de vrai.',
      faqTitle: 'Questions fréquentes',
      faq: [
        { q: 'Shobukan est-il gratuit ?', a: `Oui. Tous les modes et les ${UNIVERSES.length} univers manga sont jouables gratuitement, avec des publicités. L'abonnement Premium (${p(PRICES.monthly)} par mois ou ${p(PRICES.yearly)} par an, prix en France) retire les publicités et rend l'hébergement des parties en ligne illimité.` },
        { q: 'À combien de joueurs peut-on jouer ?', a: `De 1 à ${PLAYERS.max} joueurs selon le mode : Otaku Quiz se joue seul ou jusqu'à ${PLAYERS.quizMax}, Undercover de ${PLAYERS.undercoverMin} à ${PLAYERS.undercoverMax} joueurs. L'Anime Grid et l'Expédition se jouent en solo.` },
        { q: 'Peut-on jouer sans internet ?', a: 'Oui, en mode local : le téléphone passe de main en main et la partie fonctionne sans connexion. Les parties en ligne, l’Anime Grid et le classement ont besoin d’internet.' },
        { q: 'Peut-on jouer à distance avec des amis ?', a: 'Oui, à Undercover comme au quiz. Crée une partie en ligne et partage le code à 6 caractères ou le lien d’invitation : chacun joue sur son propre téléphone.' },
        { q: 'Quels mangas sont dans le jeu ?', a: `${UNIVERSES.length} univers : ${universeList}, plus un mode tous univers mélangés.` },
        { q: 'Sur quels téléphones Shobukan est-il disponible ?', a: 'Sur iPhone (App Store) et Android (Google Play), en français et en anglais.' },
      ],
    }
  : {
      title: 'Shobukan: anime quiz and Undercover party game with friends',
      description: 'Free mobile party game about manga (iPhone, Android): Undercover, Otaku Quiz and a daily Anime Grid. Play on one phone or online with a code.',
      h1a: 'Party game', h1b: 'manga',
      lede: `Shobukan is a free mobile party game about manga and anime. Undercover, quizzes and daily challenges across ${UNIVERSES.length} universes.`,
      lede2: 'On a single phone, even offline, or online with your friends.',
      qLabel: 'questions',
      ucA: 'Tonight, one of you', ucB: 'is lying.',
      ucList: ['Everyone gets a secret word from a manga', 'The impostor has a close word… and doesn’t know it', 'One clue each, one vote, one busted'],
      ucCta: 'How to play', ucChip: `${PLAYERS.undercoverMin} to ${PLAYERS.undercoverMax} players · online or one phone`,
      tiles: [
        { t: 'Otaku Quiz', s: `Solo or up to ${PLAYERS.quizMax} players`, img: 'quiz' },
        { t: 'Anime Grid', s: 'One grid a day, one leaderboard', img: 'grid', tag: 'Daily' },
        { t: 'Expedition', s: 'A solo adventure in chapters', img: 'shinobi' },
        { t: 'Custom packs', s: 'Your questions, your words', svg: 'M12 5v14M5 12h14' },
        { t: 'Offline', s: 'One phone, no network needed', svg: 'M7 3h10a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm4 15h2' },
        { t: 'Online', s: 'A 6-character code is all it takes', svg: 'M9 15 15 9M8 12l-2 2a3 3 0 0 0 4 4l2-2m4-4 2-2a3 3 0 0 0-4-4l-2 2' },
      ],
      shows: [
        { a: 'Otaku', b: 'Quiz', capT: 'The quiz that ends debates', capS: `${nf.format(CONTENT.questions.en)}+ questions, solo or up to ${PLAYERS.quizMax} players.`, href: ROUTES.quiz.en },
        { a: 'Anime', b: 'Grid', capT: 'One grid a day', capS: 'The rarer your answer, the higher you climb.' },
        { a: 'Expedition', b: 'solo', capT: 'Your knowledge is your weapon', capS: 'A solo adventure, chapter after chapter.' },
      ],
      rare: ['Ultra rare', 'Rare', 'Common'],
      storyTitleA: 'Your', storyTitleB: 'Undercover night', storySub: `${CONTENT.wordPairs.en}+ word pairs, ${UNIVERSES.length} universes`,
      steps: [
        { n: '01', t: 'One phone on the table', s: 'Or everyone on their own, online' },
        { n: '02', t: 'Everyone sees their word', s: 'Kakashi Hatake… or Itachi Uchiha?' },
        { n: '03', t: 'One clue each', s: '“White hair.” “Reads a lot.”' },
        { n: '04', t: 'The vote drops', s: 'The impostor was your best friend' },
      ],
      quizTitleA: 'Your anime', quizTitleB: 'quizzes', quizSub: `${UNIVERSES.length} free quizzes on the site, no sign-up`,
      quizCta: 'See all 18 quizzes',
      priceTitleA: 'Free.', priceTitleB: 'For real.',
      faqTitle: 'FAQ',
      faq: [
        { q: 'Is Shobukan free?', a: `Yes. Every mode and all ${UNIVERSES.length} manga universes are free to play, with ads. The optional Premium subscription (${p(PRICES.monthly)} per month or ${p(PRICES.yearly)} per year, prices in France) removes ads and makes online hosting unlimited.` },
        { q: 'How many players can play?', a: `From 1 to ${PLAYERS.max} depending on the mode: Otaku Quiz is played solo or with up to ${PLAYERS.quizMax} players, Undercover with ${PLAYERS.undercoverMin} to ${PLAYERS.undercoverMax}. Anime Grid and Expedition are solo.` },
        { q: 'Can you play offline?', a: 'Yes, in local mode: the phone is passed around and the game works without a connection. Online games, Anime Grid and leaderboards need internet.' },
        { q: 'Can you play remotely with friends?', a: 'Yes, both Undercover and the quiz. Create an online game and share the 6-character code or the invite link: everyone plays on their own phone.' },
        { q: 'Which manga are in the game?', a: `${UNIVERSES.length} universes: ${universeList}, plus an all-universes mix.` },
        { q: 'Which phones is Shobukan available on?', a: 'iPhone (App Store) and Android (Google Play), in English and French.' },
      ],
    }

const tileImg: Record<string, ImageMetadata> = { quiz: quizArt, grid: gridMark, shinobi }
const path = ROUTES.home[lang]
const medium = `home_${lang}`
const jsonLd = [organization(), website(), app(lang), faqPage(`${SITE}${path}#faq`, c.faq)]
const fanCard = (u: (typeof UNIVERSES)[number]) => ({ u, img: artFor(u.id), n: Math.floor((counts[u.id] ?? 0) / 10) * 10 })
---

<Base lang={lang} title={c.title} description={c.description} path={path} alternates={{ fr: ROUTES.home.fr, en: ROUTES.home.en }} jsonLd={jsonLd}>
  <div class="wrap stack">
    <!-- HERO : bannière avec cartes en éventail -->
    <section class="hero">
      <div class="fan left" aria-hidden="true">
        {fanLeft.map(fanCard).map(({ u, img, n }, i) => (
          <a class={`fcard f${i}`} href={quizPath(u, lang)} tabindex="-1" style={`--c1:${u.colors[0]};--c2:${u.colors[1]};--c3:${u.colors[2]}`}>
            <span class="fhead">{universeName(u, lang)}</span>
            {img && <Image src={img} alt="" width={200} loading="eager" />}
            <span class="fstat"><b>{n}+</b> {c.qLabel}</span>
            <span class="fok">QUIZ ✓</span>
          </a>
        ))}
      </div>
      <div class="fan right" aria-hidden="true">
        {fanRight.map(fanCard).map(({ u, img, n }, i) => (
          <a class={`fcard f${i}`} href={quizPath(u, lang)} tabindex="-1" style={`--c1:${u.colors[0]};--c2:${u.colors[1]};--c3:${u.colors[2]}`}>
            <span class="fhead">{universeName(u, lang)}</span>
            {img && <Image src={img} alt="" width={200} loading="eager" />}
            <span class="fstat"><b>{n}+</b> {c.qLabel}</span>
            <span class="fok">QUIZ ✓</span>
          </a>
        ))}
      </div>
      <svg class="wires" viewBox="0 0 1400 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <path d="M250 200 C 420 170, 470 250, 560 250" />
        <path d="M300 330 C 430 340, 470 280, 560 268" />
        <path d="M1150 190 C 980 170, 930 250, 840 250" />
        <path d="M1100 340 C 970 340, 930 280, 840 268" />
      </svg>
      <div class="vignette" aria-hidden="true"></div>
      <div class="hero-center">
        <h1>
          <span class="brandline"><Image src={icon} alt="" width={48} height={48} loading="eager" />Shobukan</span>
          <span class="display mix"><b>{c.h1a}</b> <i>{c.h1b}</i></span>
        </h1>
        <p class="hero-lede">{c.lede}<br /><span>{c.lede2}</span></p>
        <StoreButtons lang={lang} medium={medium} center />
      </div>
    </section>

    <!-- BENTO : Undercover + grille de fonctionnalités -->
    <section class="bento" id="modes">
      <article class="uc reveal">
        <Image class="uc-bg" src={undercoverBg} alt="" width={900} loading="eager" />
        <div class="uc-body">
          <h2 class="display">{c.ucA}<br /><span class="hl">{c.ucB}</span></h2>
          <ul class="check">{c.ucList.map((li) => <li>{li}</li>)}</ul>
          <div class="uc-actions">
            <a class="btn btn-primary" href={ROUTES.undercover[lang]}>{c.ucCta}</a>
            <span class="chip">{c.ucChip}</span>
          </div>
        </div>
      </article>
      <div class="tiles">
        {c.tiles.map((t) => (
          <div class="card tile reveal">
            <span class="ticon">
              {t.img ? <Image src={tileImg[t.img]} alt="" width={64} height={64} loading="lazy" /> : (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.svg} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              )}
            </span>
            <h3>{t.t} {t.tag && <span class="tag">{t.tag}</span>}</h3>
            <p>{t.s}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- VITRINES : 3 cartes colorées -->
    <section class="shows">
      <figure class="show reveal">
        <div class="art a-quiz">
          <p class="display mix stitle"><b>{c.shows[0].a}</b> <i>{c.shows[0].b}</i></p>
          <div class="mini">
            <span class="mq">{fr ? 'Combien de sabres utilise Zoro ?' : 'How many swords does Zoro use?'}</span>
            <span class="mo">2</span><span class="mo ok">3</span><span class="mo">4</span><span class="mo">5</span>
          </div>
          <Image class="brain" src={quizArt} alt="" width={220} loading="lazy" />
        </div>
        <figcaption><a href={c.shows[0].href}><b>{c.shows[0].capT}</b></a><span>{c.shows[0].capS}</span></figcaption>
      </figure>
      <figure class="show reveal">
        <div class="art a-grid">
          <p class="display mix stitle"><b>{c.shows[1].a}</b> <i>{c.shows[1].b}</i></p>
          <Image class="gmark" src={gridMark} alt="" width={280} loading="lazy" />
          <span class="rar r1">{c.rare[0]}</span><span class="rar r2">{c.rare[1]}</span><span class="rar r3">{c.rare[2]}</span>
        </div>
        <figcaption><b>{c.shows[1].capT}</b><span>{c.shows[1].capS}</span></figcaption>
      </figure>
      <figure class="show reveal">
        <div class="art a-exp">
          <p class="display mix stitle"><b>{c.shows[2].a}</b> <i>{c.shows[2].b}</i></p>
          <div class="frame"><Image src={village} alt="" width={420} loading="lazy" /></div>
          <Image class="ninja" src={shinobi} alt="" width={160} loading="lazy" />
        </div>
        <figcaption><b>{c.shows[2].capT}</b><span>{c.shows[2].capS}</span></figcaption>
      </figure>
    </section>

    <!-- DEUX GRANDS PANNEAUX -->
    <section class="duo">
      <article class="panel big reveal">
        <header class="big-head">
          <Image class="bh-icon" src={undercoverArt} alt="" width={64} height={64} loading="lazy" />
          <div><h2 class="display">Undercover</h2><p>{c.storySub}</p></div>
        </header>
        <div class="well">
          <ol class="steps">
            {c.steps.map((s) => (
              <li><span class="sn">{s.n}</span><span class="st"><b>{s.t}</b><small>{s.s}</small></span></li>
            ))}
          </ol>
          <p class="well-title display">{c.storyTitleA} <span class="hl">{c.storyTitleB}</span></p>
          <span class="pager">01 / 04</span>
        </div>
        <a class="btn btn-primary" href={ROUTES.undercover[lang]}>{c.ucCta}</a>
      </article>
      <article class="panel big reveal">
        <header class="big-head">
          <Image class="bh-icon" src={quizArt} alt="" width={64} height={64} loading="lazy" />
          <div><h2 class="display">Otaku Quiz</h2><p>{c.quizSub}</p></div>
        </header>
        <div class="well">
          <QuickQuestion lang={lang} />
          <p class="well-title display">{c.quizTitleA} <span class="hl">{c.quizTitleB}</span></p>
          <span class="pager">01 / 18</span>
        </div>
        <a class="btn btn-primary" href={ROUTES.quiz[lang]}>{c.quizCta}</a>
      </article>
    </section>

    <!-- PRIX -->
    <section class="price-sec" id="prix">
      <h2 class="display">{c.priceTitleA} <span class="hl">{c.priceTitleB}</span></h2>
      <PricingPanel lang={lang} />
    </section>
  </div>

  <Faq items={c.faq} title={c.faqTitle} />
  <CtaBand lang={lang} medium={`${medium}_footer`} />
</Base>

<style>
  .stack { display: grid; gap: clamp(16px, 2.4vw, 28px); padding-top: 16px; }

  /* ---------- HERO ---------- */
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    border-radius: var(--radius-lg); border: 1px solid var(--border);
    min-height: clamp(460px, 44vw, 560px);
    display: grid; place-items: center;
    background:
      radial-gradient(50% 70% at 50% 45%, rgba(227, 38, 61, 0.28), transparent 70%),
      radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1.4px) 0 0 / 14px 14px,
      linear-gradient(180deg, #121214, #0a0a0b);
  }
  .fan { position: absolute; top: 0; bottom: 0; width: 42%; perspective: 900px; z-index: -1; }
  .fan.left { left: -4%; }
  .fan.right { right: -4%; }
  .fcard {
    position: absolute; top: 50%; width: clamp(150px, 15vw, 210px); aspect-ratio: 0.62;
    border-radius: 18px; padding: 12px; text-decoration: none; color: #fff;
    display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start;
    background: radial-gradient(90% 60% at 50% 40%, var(--c1), transparent 70%), linear-gradient(170deg, var(--c2), var(--c3));
    border: 3px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 30px 50px rgba(0, 0, 0, 0.55);
  }
  .fcard :global(img) { width: 78%; height: auto; align-self: center; filter: drop-shadow(0 10px 12px rgba(0, 0, 0, 0.35)); }
  .fhead { background: rgba(0, 0, 0, 0.55); border-radius: 999px; padding: 5px 10px; font-weight: 700; font-size: 13px; white-space: nowrap; }
  .fstat { font-size: 13px; font-weight: 600; background: rgba(0, 0, 0, 0.45); border-radius: 8px; padding: 4px 8px; }
  .fstat b { font-family: var(--font-display); font-size: 17px; }
  .fok { position: absolute; bottom: 44px; left: 12px; font-family: var(--font-display); font-weight: 700; font-size: 18px; color: #fff; background: #12a35b; border: 2px solid #fff; border-radius: 8px; padding: 2px 8px; transform: rotate(-6deg); }
  .left .f0 { left: 0; transform: translateY(-50%) rotateY(28deg) rotateZ(-4deg); }
  .left .f1 { left: 24%; transform: translateY(-46%) rotateY(26deg) rotateZ(-2deg) scale(0.95); }
  .left .f2 { left: 48%; transform: translateY(-42%) rotateY(24deg) scale(0.9); }
  .right .f0 { right: 0; transform: translateY(-50%) rotateY(-28deg) rotateZ(4deg); }
  .right .f1 { right: 24%; transform: translateY(-46%) rotateY(-26deg) rotateZ(2deg) scale(0.95); }
  .right .f2 { right: 48%; transform: translateY(-42%) rotateY(-24deg) scale(0.9); }
  /* Voile sombre derrière le texte central : les cartes et les pointillés passent dessous. */
  .vignette { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(ellipse 30% 58% at 50% 50%, rgba(10, 10, 11, 0.96), rgba(10, 10, 11, 0.75) 55%, transparent 100%); }
  @media (max-width: 860px) { .vignette { background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(10, 10, 11, 0.95), rgba(10, 10, 11, 0.6) 70%, transparent 100%); } }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; fill: none; stroke: rgba(255, 255, 255, 0.55); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 0.5 9; }
  .hero-center { text-align: center; padding: 40px 16px; max-width: 640px; }
  .hero-center h1 { margin: 0; display: grid; gap: 14px; justify-items: center; }
  .brandline { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-brand); font-size: 22px; font-weight: 400; letter-spacing: 0.02em; }
  .brandline :global(img) { width: 30px; height: 30px; border-radius: 8px; }
  .hero-center .mix { font-size: clamp(38px, 6vw, 72px); line-height: 1; text-shadow: 0 6px 30px rgba(0, 0, 0, 0.6); }
  .hero-lede { color: #d4d4d8; font-size: clamp(15px, 1.5vw, 17px); margin: 18px auto 26px; max-width: 520px; text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8); }
  .hero-lede span { color: #fff; }
  @media (max-width: 860px) {
    .fan { width: 60%; opacity: 0.45; }
    .fan.left { left: -28%; } .fan.right { right: -28%; }
    .wires { display: none; }
  }

  /* ---------- BENTO ---------- */
  .bento { display: grid; gap: 12px; }
  @media (min-width: 1000px) { .bento { grid-template-columns: 1fr 1.05fr; gap: 16px; } }
  .uc { position: relative; overflow: hidden; border-radius: var(--radius-lg); border: 1px solid var(--border); min-height: 300px; display: flex; align-items: flex-end; background: #111; }
  .uc-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; filter: grayscale(0.85) contrast(1.1); opacity: 0.55; }
