---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import StoreButtons from './StoreButtons.astro'
import UniverseMarquee from './UniverseMarquee.astro'
import QuickQuestion from './QuickQuestion.astro'
import Faq from './Faq.astro'
import CtaBand from './CtaBand.astro'
import arena from '../assets/art/arena-shonen-pop.jpg'
import undercoverArt from '../assets/art/undercover.jpg'
import undercoverBg from '../assets/art/undercover-game-bg.jpg'
import quizArt from '../assets/art/otaku-quiz.jpg'
import gridMark from '../assets/art/anime-grid-mark.png'
import village from '../assets/art/campaign-village.jpg'
import { CONTENT, PLAYERS, PRICES, SITE, UNIVERSES, formatPrice, type Lang } from '../data/product'
import { ROUTES } from '../i18n/ui'
import { app, faqPage, organization, website } from '../data/schema'

interface Props { lang: Lang }
const { lang } = Astro.props
const fr = lang === 'fr'
const p = (v: number) => formatPrice(v, lang)
const universeList = UNIVERSES.map((u) => (fr ? u.fr : u.en)).join(', ')
const nf = new Intl.NumberFormat(fr ? 'fr-FR' : 'en-US')

const c = fr
  ? {
      title: 'Shobukan : quiz manga et Undercover anime entre amis',
      description: 'Jeu mobile gratuit de soirée sur le manga (iPhone, Android) : Undercover, Otaku Quiz, Anime Grid du jour. Sur un seul téléphone ou en ligne avec un code.',
      eyebrow: 'Party game manga · gratuit sur iPhone & Android',
      h1a: 'Ce soir,',
      h1b: "l'un de vous ment.",
      lede: `<strong>Shobukan est un party game manga gratuit sur iPhone et Android.</strong> Démasque l'infiltré, prouve que tu connais vraiment One Piece et règle enfin le débat : qui est le plus otaku du groupe ?`,
      bubble1: "C'est pas moi !",
      bubble2: 'Trop facile.',
      sfx: 'DOKI !',
      storyEyebrow: 'Une soirée Shobukan',
      storyTitle: 'Comment ça se passe, en vrai.',
      s1t: 'Un seul téléphone sur la table.',
      s1b: 'Pas de console, pas de compte à créer. Ça marche même sans réseau, en soirée, en convention ou dans le train.',
      s2t: 'Chacun découvre son mot en secret.',
      s2b: "Tout le monde a le même… sauf l'infiltré. Le pire ? Il ne sait pas que c'est lui.",
      word: 'Ton mot',
      wordA: 'Kakashi Hatake',
      wordB: 'Itachi Uchiha',
      s3t: 'Un indice chacun. Les regards changent.',
      s3b: "Trop précis, tu aides l'infiltré. Trop vague, tu deviens suspect.",
      clues: ['Cheveux blancs.', 'Il lit beaucoup.', 'Euh… il est fort ?'],
      s4t: 'Le vote tombe.',
      s4b: "L'infiltré était ton meilleur pote depuis le début. Revanche ?",
      stamp: 'Démasqué',
      s4link: "Les règles complètes d'Undercover",
      quizEyebrow: 'Et pour départager tout le monde',
      quizTitle: 'Le quiz qui met fin aux débats.',
      quizBody: `Une question, quatre réponses, une seule bonne. Plus de ${nf.format(CONTENT.questions.fr)} questions sur ${UNIVERSES.length} mangas, à jouer :`,
      quizWays: ['seul, pour monter en grade', 'à plusieurs sur un même téléphone', `en ligne jusqu'à ${PLAYERS.quizMax}, chacun sur son téléphone`],
      quizTry: 'Essaie, là, tout de suite :',
      soloEyebrow: 'Quand tout le monde est rentré',
      soloTitle: 'De quoi revenir chaque jour.',
      gridT: 'Une grille par jour.',
      gridB: 'Trois mangas, trois critères, neuf cases. Trouve le bon personnage pour chaque croisement, et vise la réponse que personne n’a osé : plus elle est rare, plus tu grimpes au classement.',
      expT: 'Une aventure où ta culture est ta seule arme.',
      expB: 'L’Expédition t’emmène de chapitre en chapitre : réponds juste pour vaincre tes ennemis, choisis ta route et va le plus loin possible.',
      packsT: 'Et si vos private jokes devenaient un jeu ?',
      packsB: 'Crée ton propre pack de questions ou de mots, sur ton anime de niche ou sur ton groupe. Une fois créé, il se joue gratuitement par tout le monde.',
      numbers: [
        { n: String(UNIVERSES.length), l: 'univers manga' },
        { n: `${nf.format(CONTENT.questions.fr)}+`, l: 'questions de quiz' },
        { n: `${CONTENT.wordPairs.fr}+`, l: 'paires de mots Undercover' },
        { n: `1-${PLAYERS.max}`, l: 'joueurs' },
      ],
      univEyebrow: 'Ton manga est dedans',
      univTitle: 'De Naruto à Kingdom.',
      univBody: 'Choisis un univers ou mélange-les tous. Touche un manga pour tester son quiz gratuit.',
      freeTitle: 'Gratuit. Pour de vrai.',
      freeBody: `Tous les modes et tous les univers se jouent sans payer, avec des pubs. Premium (${p(PRICES.monthly)}/mois) retire les pubs pour toute la table et rend les parties en ligne illimitées.`,
      freeLink: 'Voir les prix',
      faqTitle: 'Questions fréquentes',
      faq: [
        { q: 'Shobukan est-il gratuit ?', a: `Oui. Tous les modes et les ${UNIVERSES.length} univers manga sont jouables gratuitement, avec des publicités. L'abonnement Premium (${p(PRICES.monthly)} par mois ou ${p(PRICES.yearly)} par an, prix en France) retire les publicités et rend l'hébergement des parties en ligne illimité.` },
        { q: 'À combien de joueurs peut-on jouer ?', a: `De 1 à ${PLAYERS.max} joueurs selon le mode : Otaku Quiz se joue seul ou jusqu'à ${PLAYERS.quizMax}, Undercover de ${PLAYERS.undercoverMin} à ${PLAYERS.undercoverMax} joueurs. L'Anime Grid et l'Expédition se jouent en solo.` },
        { q: 'Peut-on jouer sans internet ?', a: 'Oui, en mode local : le téléphone passe de main en main et la partie fonctionne sans connexion. Les parties en ligne, l’Anime Grid et le classement ont besoin d’internet.' },
        { q: 'Peut-on jouer à distance avec des amis ?', a: 'Oui, à Undercover comme au quiz. Crée une partie en ligne et partage le code à 6 caractères ou le lien d’invitation : chacun joue sur son propre téléphone.' },
        { q: 'Quels mangas sont dans le jeu ?', a: `${UNIVERSES.length} univers : ${universeList}, plus un mode tous univers mélangés.` },
        { q: 'Sur quels téléphones Shobukan est-il disponible ?', a: 'Sur iPhone (App Store) et Android (Google Play), en français et en anglais.' },
      ],
    }
  : {
      title: 'Shobukan: anime quiz and Undercover party game with friends',
      description: 'Free mobile party game about manga (iPhone, Android): Undercover, Otaku Quiz and a daily Anime Grid. Play on one phone or online with a code.',
      eyebrow: 'Manga party game · free on iPhone & Android',
      h1a: 'Tonight,',
      h1b: 'one of you is lying.',
      lede: `<strong>Shobukan is a free manga party game for iPhone and Android.</strong> Unmask the impostor, prove you really know One Piece and finally settle it: who's the biggest otaku in the group?`,
      bubble1: 'It wasn’t me!',
      bubble2: 'Too easy.',
      sfx: 'DOKI!',
      storyEyebrow: 'A Shobukan night',
      storyTitle: 'How it actually goes.',
      s1t: 'One phone on the table.',
      s1b: 'No console, no account to create. It even works offline, at parties, conventions or on the train.',
      s2t: 'Everyone sees their word in secret.',
      s2b: 'Everyone has the same one… except the impostor. The worst part? They don’t know it’s them.',
      word: 'Your word',
      wordA: 'Kakashi Hatake',
      wordB: 'Itachi Uchiha',
      s3t: 'One clue each. The looks change.',
      s3b: 'Too precise and you help the impostor. Too vague and you look suspicious.',
      clues: ['White hair.', 'Reads a lot.', 'Uh… he’s strong?'],
      s4t: 'The vote drops.',
      s4b: 'The impostor was your best friend all along. Rematch?',
      stamp: 'Busted',
      s4link: 'Full Undercover rules',
      quizEyebrow: 'And to settle every argument',
      quizTitle: 'The quiz that ends debates.',
      quizBody: `One question, four answers, only one is right. Over ${nf.format(CONTENT.questions.en)} questions across ${UNIVERSES.length} anime, played:`,
      quizWays: ['solo, to rank up', 'with friends on a single phone', `online with up to ${PLAYERS.quizMax}, each on their own phone`],
      quizTry: 'Try it right now:',
      soloEyebrow: 'When everyone has gone home',
      soloTitle: 'Something to come back to every day.',
      gridT: 'One grid a day.',
      gridB: 'Three anime, three criteria, nine cells. Find the right character for each crossing, and go for the answer nobody dared: the rarer it is, the higher you climb.',
      expT: 'An adventure where your knowledge is your only weapon.',
      expB: 'Expedition takes you from chapter to chapter: answer right to defeat enemies, pick your route and push as far as you can.',
      packsT: 'What if your inside jokes became a game?',
      packsB: 'Create your own pack of questions or words, about your niche anime or your friend group. Once created, anyone can play it for free.',
      numbers: [
        { n: String(UNIVERSES.length), l: 'manga universes' },
        { n: `${nf.format(CONTENT.questions.en)}+`, l: 'quiz questions' },
        { n: `${CONTENT.wordPairs.en}+`, l: 'Undercover word pairs' },
        { n: `1-${PLAYERS.max}`, l: 'players' },
      ],
      univEyebrow: 'Your anime is in there',
      univTitle: 'From Naruto to Kingdom.',
      univBody: 'Pick one universe or mix them all. Tap an anime to try its free quiz.',
      freeTitle: 'Free. For real.',
      freeBody: `Every mode and every universe can be played without paying, with ads. Premium (${p(PRICES.monthly)}/month) removes ads for the whole table and makes online games unlimited.`,
      freeLink: 'See pricing',
      faqTitle: 'FAQ',
      faq: [
        { q: 'Is Shobukan free?', a: `Yes. Every mode and all ${UNIVERSES.length} manga universes are free to play, with ads. The optional Premium subscription (${p(PRICES.monthly)} per month or ${p(PRICES.yearly)} per year, prices in France) removes ads and makes online hosting unlimited.` },
        { q: 'How many players can play?', a: `From 1 to ${PLAYERS.max} depending on the mode: Otaku Quiz is played solo or with up to ${PLAYERS.quizMax} players, Undercover with ${PLAYERS.undercoverMin} to ${PLAYERS.undercoverMax}. Anime Grid and Expedition are solo.` },
        { q: 'Can you play offline?', a: 'Yes, in local mode: the phone is passed around and the game works without a connection. Online games, Anime Grid and leaderboards need internet.' },
        { q: 'Can you play remotely with friends?', a: 'Yes, both Undercover and the quiz. Create an online game and share the 6-character code or the invite link: everyone plays on their own phone.' },
        { q: 'Which manga are in the game?', a: `${UNIVERSES.length} universes: ${universeList}, plus an all-universes mix.` },
        { q: 'Which phones is Shobukan available on?', a: 'iPhone (App Store) and Android (Google Play), in English and French.' },
      ],
    }

const path = ROUTES.home[lang]
const medium = `home_${lang}`
const jsonLd = [organization(), website(), app(lang), faqPage(`${SITE}${path}#faq`, c.faq)]
---

<Base lang={lang} title={c.title} description={c.description} path={path} alternates={{ fr: ROUTES.home.fr, en: ROUTES.home.en }} jsonLd={jsonLd}>
  <!-- HERO : une planche de manga -->
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1 class="display"><span>{c.h1a}</span> <span class="accent">{c.h1b}</span></h1>
        <p class="lede" set:html={c.lede} />
        <div class="hero-stores"><StoreButtons lang={lang} medium={medium} /></div>
      </div>
      <div class="page" aria-hidden="true">
        <div class="panel pa"><Image src={arena} alt="" width={560} loading="eager" fetchpriority="high" /></div>
        <div class="panel pb">
          <Image src={undercoverArt} alt="" width={360} loading="eager" />
          <span class="bubble b1">{c.bubble1}</span>
        </div>
        <div class="panel pc">
          <Image src={quizArt} alt="" width={360} loading="eager" />
          <span class="bubble b2">{c.bubble2}</span>
        </div>
        <span class="sfx">{c.sfx}</span>
      </div>
    </div>
  </section>

  <!-- RÉCIT : une soirée en 4 cases -->
  <section class="section story" id="modes">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{c.storyEyebrow}</p>
        <h2 class="display">{c.storyTitle}</h2>
      </div>
      <ol class="strip">
        <li class="cell c1 reveal">
          <span class="num">01</span>
          <div class="visual phone" aria-hidden="true">
            <svg viewBox="0 0 64 96"><rect x="4" y="4" width="56" height="88" rx="10" fill="none" stroke="currentColor" stroke-width="5"/><circle cx="32" cy="80" r="4" fill="currentColor"/><path d="M20 38h24M20 48h16" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>
          </div>
          <h3>{c.s1t}</h3>
          <p>{c.s1b}</p>
        </li>
        <li class="cell c2 reveal">
          <span class="num">02</span>
          <div class="visual words" aria-hidden="true">
            <span class="wcard"><small>{c.word}</small>{c.wordA}</span>
            <span class="wcard odd"><small>{c.word}</small>{c.wordB}</span>
          </div>
          <h3>{c.s2t}</h3>
          <p>{c.s2b}</p>
        </li>
        <li class="cell c3 reveal">
          <span class="num">03</span>
          <div class="visual clues" aria-hidden="true">
            {c.clues.map((cl, i) => <span class:list={['clue', `k${i}`]}>{cl}</span>)}
          </div>
          <h3>{c.s3t}</h3>
          <p>{c.s3b}</p>
        </li>
        <li class="cell c4 reveal">
          <Image class="cell-bg" src={undercoverBg} alt="" width={700} loading="lazy" />
          <span class="num">04</span>
          <div class="visual stampbox" aria-hidden="true"><span class="stamp">{c.stamp}</span></div>
          <h3>{c.s4t}</h3>
          <p>{c.s4b}</p>
          <a href={ROUTES.undercover[lang]}>{c.s4link} →</a>
        </li>
      </ol>
    </div>
  </section>

  <!-- QUIZ : question jouable -->
  <section class="section quiz">
    <div class="halftone quiz-dots" aria-hidden="true"></div>
    <div class="wrap quiz-grid">
      <div>
        <p class="eyebrow">{c.quizEyebrow}</p>
        <h2 class="display">{c.quizTitle}</h2>
        <p class="lede">{c.quizBody}</p>
        <ul class="ways">{c.quizWays.map((w) => <li>{w}</li>)}</ul>
      </div>
      <div class="try">
        <p class="try-label">{c.quizTry}</p>
        <QuickQuestion lang={lang} />
      </div>
    </div>
  </section>

  <!-- SOLO : éditorial -->
  <section class="section solo">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{c.soloEyebrow}</p>
        <h2 class="display">{c.soloTitle}</h2>
      </div>
      <div class="feature-row reveal">
        <div class="feature-text">
          <span class="kicker">Anime Grid</span>
          <h3 class="display">{c.gridT}</h3>
          <p>{c.gridB}</p>
        </div>
        <div class="feature-visual grid-visual"><Image src={gridMark} alt={fr ? "Logo de l'Anime Grid : une grille de 3 par 3" : 'Anime Grid logo: a 3 by 3 grid'} width={420} loading="lazy" /></div>
      </div>
      <div class="banner reveal">
        <Image class="banner-bg" src={village} alt="" width={1200} loading="lazy" />
        <div class="banner-text">
          <span class="kicker">{fr ? 'Expédition' : 'Expedition'}</span>
          <h3 class="display">{c.expT}</h3>
          <p>{c.expB}</p>
        </div>
      </div>
      <div class="packs reveal">
        <h3>{c.packsT}</h3>
        <p>{c.packsB}</p>
      </div>
    </div>
  </section>

  <!-- CHIFFRES -->
  <section class="numbers" aria-label={fr ? 'Shobukan en chiffres' : 'Shobukan in numbers'}>
    <div class="wrap nums">
      {c.numbers.map((n) => <div class="numcell"><b>{n.n}</b><span>{n.l}</span></div>)}
    </div>
  </section>

  <!-- UNIVERS -->
  <section class="section univ">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">{c.univEyebrow}</p>
        <h2 class="display">{c.univTitle}</h2>
        <p class="lede">{c.univBody}</p>
      </div>
    </div>
    <UniverseMarquee lang={lang} />
  </section>

  <!-- GRATUIT -->
  <section class="section free">
    <div class="wrap free-inner reveal">
      <h2 class="display">{c.freeTitle}</h2>
      <p>{c.freeBody}</p>
      <a class="btn btn-ghost" href={ROUTES.pricing[lang]}>{c.freeLink} →</a>
    </div>
  </section>

  <Faq items={c.faq} title={c.faqTitle} />
  <CtaBand lang={lang} medium={`${medium}_footer`} />
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; overflow: hidden; padding: clamp(36px, 7vw, 88px) 0 clamp(64px, 9vw, 112px); }
  .glow {
    position: absolute; top: -25%; right: -15%; width: 1000px; height: 1000px; max-width: 140vw;
    background: radial-gradient(closest-side, rgba(227, 38, 61, 0.42), rgba(142, 22, 38, 0.15) 60%, transparent);
    pointer-events: none;
  }
  .hero-grid { position: relative; display: grid; gap: 56px; align-items: center; }
  @media (min-width: 980px) { .hero-grid { grid-template-columns: 1fr 1fr; gap: 40px; } }
  .hero h1 { font-size: clamp(42px, 8vw, 78px); line-height: 1.02; }
  .hero h1 span { display: block; }
  .hero-stores { margin-top: 34px; }

  /* Planche de manga : 3 cases aux gouttières inclinées */
  .page {
    position: relative; width: min(520px, 100%); justify-self: center;
    aspect-ratio: 1 / 1.08;
    display: grid; grid-template-columns: 1.15fr 1fr; grid-template-rows: 1fr 1fr; gap: 12px;
    transform: rotate(2deg);
  }
  .panel {
    position: relative; overflow: hidden; background: #000;
    outline: 4px solid #fff; outline-offset: -2px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
  }
  .panel :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pa { grid-row: 1 / 3; clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%); }
  .pb { clip-path: polygon(8% 0, 100% 0, 100% 100%, 4% 94%); margin-left: -6%; }
  .pc { clip-path: polygon(4% 0, 100% 6%, 100% 100%, 0 100%); margin-left: -10%; }
  .bubble {
    position: absolute; z-index: 2; background: #fff; color: #120609;
    font-weight: 800; font-size: clamp(13px, 1.6vw, 17px); line-height: 1.2;
    padding: 10px 14px; border-radius: 50% / 45%; border: 3px solid #120609;
    white-space: nowrap;
  }
  .bubble::after {
    content: ''; position: absolute; width: 14px; height: 14px; background: #fff;
    border-right: 3px solid #120609; border-bottom: 3px solid #120609;
  }
  .b1 { left: 14%; bottom: 10%; transform: rotate(-4deg); }
  .b1::after { top: -9px; right: 26px; transform: rotate(225deg); }
  .b2 { right: 6%; top: 10%; transform: rotate(5deg); }
  .b2::after { bottom: -9px; left: 24px; transform: rotate(45deg); }
  .sfx {
    position: absolute; left: -4%; top: 6%; z-index: 3;
    font-family: var(--font-display); font-size: clamp(34px, 5vw, 56px); color: var(--gold);
    -webkit-text-stroke: 3px #120609; paint-order: stroke fill;
    transform: rotate(-12deg); text-shadow: 4px 4px 0 var(--accent);
  }

  /* ---------- RÉCIT ---------- */
  .strip { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .strip { grid-template-columns: 1.1fr 1fr 1fr 1.25fr; } }
  .cell {
    position: relative; overflow: hidden; min-height: 380px;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 26px; border: 3px solid #f8f0ec; background: var(--surface);
  }
  .cell h3 { font-size: 21px; line-height: 1.2; position: relative; }
  .cell p { color: var(--muted); margin: 10px 0 0; position: relative; }
  .cell a { position: relative; margin-top: 14px; font-weight: 700; text-decoration: none; }
  .num { position: absolute; top: 18px; left: 22px; font-family: var(--font-display); font-size: 22px; color: var(--accent-hot); z-index: 1; }
  .visual { flex: 1; display: grid; place-items: center; position: relative; margin: 34px 0 18px; }
  .c1 { background: radial-gradient(circle at 50% 35%, rgba(227, 38, 61, 0.35), transparent 60%), var(--surface); }
  .phone svg { width: 84px; color: var(--text); transform: rotate(-8deg); filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.5)); }
  .words { display: grid; gap: 10px; place-items: center; }
  .wcard {
    display: block; text-align: center; background: #fff; color: #120609; font-weight: 800; font-size: 17px;
    padding: 10px 18px; border-radius: 10px; box-shadow: 5px 5px 0 var(--gold); transform: rotate(-3deg);
  }
  .wcard small { display: block; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: #8a7a7f; }
  .wcard.odd { box-shadow: 5px 5px 0 var(--accent); transform: rotate(4deg); }
  .clues { display: grid; gap: 10px; justify-items: start; width: 100%; }
  .clue {
    background: #fff; color: #120609; font-weight: 750; font-size: 15px; padding: 8px 14px;
    border-radius: 18px 18px 18px 4px; border: 2px solid #120609;
  }
  .k1 { justify-self: end; border-radius: 18px 18px 4px 18px; }
  .k2 { background: var(--gold); transform: rotate(-3deg); }
  .c4 { border-color: var(--accent); }
  .cell-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35; }
  .c4::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 20%, rgba(14, 5, 7, 0.95) 75%); }
  .stamp {
    font-family: var(--font-display); font-size: clamp(26px, 3vw, 34px); color: var(--accent-hot);
    border: 4px solid var(--accent-hot); border-radius: 8px; padding: 4px 16px;
    transform: rotate(-14deg); text-transform: uppercase; letter-spacing: 0.04em;
    box-shadow: inset 0 0 0 2px rgba(255, 74, 92, 0.3);
    background: rgba(14, 5, 7, 0.4);
  }

  /* ---------- QUIZ ---------- */
  .quiz { overflow: hidden; background: linear-gradient(180deg, var(--bg), #1b0810 50%, var(--bg)); }
  .quiz-dots { position: absolute; inset: 0; mask-image: radial-gradient(50% 60% at 75% 50%, #000, transparent); }
  .quiz-grid { position: relative; display: grid; gap: 48px; align-items: center; }
  @media (min-width: 940px) { .quiz-grid { grid-template-columns: 1.1fr 1fr; } }
  .ways { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 10px; }
  .ways li { padding-left: 30px; position: relative; font-weight: 650; }
  .ways li::before { content: '→'; position: absolute; left: 0; color: var(--gold); font-weight: 800; }
  .try { max-width: 480px; justify-self: center; width: 100%; }
