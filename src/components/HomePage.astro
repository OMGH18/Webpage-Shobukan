---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Base from '../layouts/Base.astro'
import StoreButtons from './StoreButtons.astro'
import QuickQuestion from './QuickQuestion.astro'
import PricingPanel from './PricingPanel.astro'
import Faq from './Faq.astro'
import CtaBand from './CtaBand.astro'
import rainArt from '../assets/art/chapter-rain.jpg'
import mountainArt from '../assets/art/chapter-mountain.jpg'
import summitArt from '../assets/art/chapter-summit.jpg'
import pagesArt from '../assets/art/format-picker-bg.jpg'
import slotArt from '../assets/art/anime-grid-slot-machine.jpg'
import CardFan from './CardFan.astro'
import UniverseMarquee from './UniverseMarquee.astro'
import { CONTENT, PLAYERS, PRICES, SITE, UNIVERSES, formatPrice, universeName, type Lang } from '../data/product'
import { ROUTES } from '../i18n/ui'
import { app, faqPage, organization, website } from '../data/schema'

interface Props { lang: Lang }
const { lang } = Astro.props
const fr = lang === 'fr'
const p = (v: number) => formatPrice(v, lang)
const nf = new Intl.NumberFormat(fr ? 'fr-FR' : 'en-US')
const universeList = UNIVERSES.map((u) => universeName(u, lang)).join(', ')

const c = fr
  ? {
      title: 'Shobukan : quiz manga et Undercover anime entre amis',
      description: 'Jeu mobile gratuit de soirée sur le manga (iPhone, Android) : Undercover, Otaku Quiz, Anime Grid du jour. Sur un seul téléphone ou en ligne avec un code.',
      h1a: 'Qui est le vrai otaku', h1b: 'de la bande ?',
      univTitle: 'De Naruto à Kingdom', univSub: 'Touche un manga pour tester son quiz gratuit.',
      lede: `Shobukan est un jeu mobile gratuit de soirée sur le thème du manga : Undercover, quiz et défis quotidiens sur ${UNIVERSES.length} univers.`,
      lede2: 'Sur un seul téléphone, même sans réseau, ou en ligne avec tes potes.',
      ucA: 'Undercover :', ucB: 'trouve l’infiltré.',
      ucList: ['Chacun reçoit un mot secret tiré d’un manga', "L'infiltré a un mot proche… et ne le sait pas", 'Un indice chacun, un vote, un démasqué'],
      ucCta: 'Les règles du jeu', ucChip: `${PLAYERS.undercoverMin} à ${PLAYERS.undercoverMax} joueurs · en ligne ou même téléphone`,
      feats: {
        online: { t: 'En ligne, chacun son téléphone', s: 'Un code à 6 caractères et toute la bande rejoint la partie.' },
        local: { t: 'Hors ligne, un seul téléphone', s: 'Le téléphone fait le tour de la table, même sans réseau.', players: `jusqu'à ${PLAYERS.max} joueurs` },
        packs: { t: 'Tes propres packs', s: `Tes questions, tes mots, vos délires de groupe. Dès ${p(PRICES.creatorCredit)}.`, cards: ['Le prof de maths', 'Le chat de Léa'] },
      },
      shows: [
        { a: 'Otaku', b: 'Quiz', capT: 'Le quiz qui met fin aux débats', capS: `${nf.format(CONTENT.questions.fr)}+ questions, seul ou jusqu'à ${PLAYERS.quizMax} joueurs.`, href: ROUTES.quiz.fr },
        { a: 'Anime', b: 'Grid', capT: 'Une grille par jour', capS: 'Plus ta réponse est rare, plus tu grimpes au classement.' },
        { a: 'Mode', b: 'Histoire', capT: 'Ta culture est ta seule arme', capS: 'Une aventure solo, de chapitre en chapitre.' },
      ],
      rare: ['Ultra rare', 'Rare', 'Peu commun', 'Commun'],
      crit: ['Épéiste', 'Antagoniste', 'Mentor'],
      chapters: ['La brume du pont', 'La Forêt de la Mort', 'La Vallée de la Fin'],
      word: 'Ton mot', noWord: 'Aucun mot', roles: ['Civil', 'Civil', 'Infiltré', 'Mister White'],
      // Vraie paire du jeu (word_pairs_fr.csv)
      pair: ['Kakashi Hatake', 'Sasuke Uchiha'],
      tryQuiz: 'Tester un quiz',
      trust: [
        { t: 'Gratuit', s: 'Sans compte à créer', svg: 'M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2 8h20v4H2zM12 21V8m0 0H7.5a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8Zm0 0h4.5a2.5 2.5 0 1 0 0-5C13 3 12 8 12 8Z' },
        { t: `${nf.format(CONTENT.questions.fr)}+ questions`, s: `${UNIVERSES.length} univers manga`, svg: 'M4 5a2 2 0 0 1 2-2h13v15H6a2 2 0 0 0-2 2V5Zm0 15a2 2 0 0 0 2 2h13v-4M9 8h6' },
        { t: `${PLAYERS.min} à ${PLAYERS.max} joueurs`, s: 'En ligne ou sur un téléphone', svg: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8' },
      ],
      quizQ: 'Combien de sabres utilise Zoro ?',
      tqTitle: 'Une question pour te chauffer',
      quizTitleA: 'Tes quiz', quizTitleB: 'manga', quizSub: `${UNIVERSES.length} quiz gratuits sur le site, 5 questions chacun, sans inscription.`,
      quizCta: 'Voir les 18 quiz',
      priceTitleA: 'Gratuit.', priceTitleB: 'Pour de vrai.',
      faqTitle: 'Questions fréquentes',
      faq: [
        { q: 'Shobukan est-il gratuit ?', a: `Oui. Tous les modes et les ${UNIVERSES.length} univers manga sont jouables gratuitement, avec des publicités. L'abonnement Premium (${p(PRICES.monthly)} par mois ou ${p(PRICES.yearly)} par an, prix en France) retire les publicités et rend l'hébergement des parties en ligne illimité.` },
        { q: 'À combien de joueurs peut-on jouer ?', a: `De 1 à ${PLAYERS.max} joueurs selon le mode : Otaku Quiz se joue seul ou jusqu'à ${PLAYERS.quizMax}, Undercover de ${PLAYERS.undercoverMin} à ${PLAYERS.undercoverMax} joueurs. L'Anime Grid et le Mode Histoire se jouent en solo.` },
        { q: 'Peut-on jouer sans internet ?', a: 'Oui, en mode local : le téléphone passe de main en main et la partie fonctionne sans connexion. Les parties en ligne, l’Anime Grid et le classement ont besoin d’internet.' },
        { q: 'Peut-on jouer à distance avec des amis ?', a: 'Oui, à Undercover comme au quiz. Crée une partie en ligne et partage le code à 6 caractères ou le lien d’invitation : chacun joue sur son propre téléphone.' },
        { q: 'Quels mangas sont dans le jeu ?', a: `${UNIVERSES.length} univers : ${universeList}, plus un mode tous univers mélangés.` },
        { q: 'Sur quels téléphones Shobukan est-il disponible ?', a: 'Sur iPhone (App Store) et Android (Google Play), en français et en anglais.' },
      ],
    }
  : {
      title: 'Shobukan: anime quiz and Undercover party game with friends',
      description: 'Free mobile party game about manga (iPhone, Android): Undercover, Otaku Quiz and a daily Anime Grid. Play on one phone or online with a code.',
      h1a: 'Who’s the real otaku', h1b: 'in your crew?',
      univTitle: 'From Naruto to Kingdom', univSub: 'Tap an anime to try its free quiz.',
      lede: `Shobukan is a free mobile party game about manga and anime: Undercover, quizzes and daily challenges across ${UNIVERSES.length} universes.`,
      lede2: 'On a single phone, even offline, or online with your friends.',
      ucA: 'Undercover:', ucB: 'find the impostor.',
      ucList: ['Everyone gets a secret word from a manga', 'The impostor has a close word… and doesn’t know it', 'One clue each, one vote, one busted'],
      ucCta: 'How to play', ucChip: `${PLAYERS.undercoverMin} to ${PLAYERS.undercoverMax} players · online or one phone`,
      feats: {
        online: { t: 'Online, everyone on their phone', s: 'A 6-character code and the whole crew joins the game.' },
        local: { t: 'Offline, one phone', s: 'The phone goes around the table, even with no signal.', players: `up to ${PLAYERS.max} players` },
        packs: { t: 'Your own packs', s: `Your questions, your words, your inside jokes. From ${p(PRICES.creatorCredit)}.`, cards: ['Our math teacher', 'Leah’s cat'] },
      },
      shows: [
        { a: 'Otaku', b: 'Quiz', capT: 'The quiz that ends debates', capS: `${nf.format(CONTENT.questions.en)}+ questions, solo or up to ${PLAYERS.quizMax} players.`, href: ROUTES.quiz.en },
        { a: 'Anime', b: 'Grid', capT: 'One grid a day', capS: 'The rarer your answer, the higher you climb.' },
        { a: 'Story', b: 'Mode', capT: 'Your knowledge is your weapon', capS: 'A solo adventure, chapter after chapter.' },
      ],
      rare: ['Ultra rare', 'Rare', 'Uncommon', 'Common'],
      crit: ['Swordsman', 'Antagonist', 'Mentor'],
      chapters: ['Mist Over the Bridge', 'The Forest of Death', "The Valley's End"],
      word: 'Your word', noWord: 'No word', roles: ['Civilian', 'Civilian', 'Impostor', 'Mister White'],
      // Real pair from the game (word_pairs_en.csv)
      pair: ['Itachi Uchiha', 'Sasuke Uchiha'],
      tryQuiz: 'Try a quiz',
      trust: [
        { t: 'Free', s: 'No account needed', svg: 'M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2 8h20v4H2zM12 21V8m0 0H7.5a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8Zm0 0h4.5a2.5 2.5 0 1 0 0-5C13 3 12 8 12 8Z' },
        { t: `${nf.format(CONTENT.questions.en)}+ questions`, s: `${UNIVERSES.length} manga universes`, svg: 'M4 5a2 2 0 0 1 2-2h13v15H6a2 2 0 0 0-2 2V5Zm0 15a2 2 0 0 0 2 2h13v-4M9 8h6' },
        { t: `${PLAYERS.min} to ${PLAYERS.max} players`, s: 'Online or on one phone', svg: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8' },
      ],
      quizQ: 'How many swords does Zoro use?',
      tqTitle: 'One question to warm up',
      quizTitleA: 'Your anime', quizTitleB: 'quizzes', quizSub: `${UNIVERSES.length} free quizzes on the site, 5 questions each, no sign-up.`,
      quizCta: 'See all 18 quizzes',
      priceTitleA: 'Free.', priceTitleB: 'For real.',
      faqTitle: 'FAQ',
      faq: [
        { q: 'Is Shobukan free?', a: `Yes. Every mode and all ${UNIVERSES.length} manga universes are free to play, with ads. The optional Premium subscription (${p(PRICES.monthly)} per month or ${p(PRICES.yearly)} per year, prices in France) removes ads and makes online hosting unlimited.` },
        { q: 'How many players can play?', a: `From 1 to ${PLAYERS.max} depending on the mode: Otaku Quiz is played solo or with up to ${PLAYERS.quizMax} players, Undercover with ${PLAYERS.undercoverMin} to ${PLAYERS.undercoverMax}. Anime Grid and Story Mode are solo.` },
        { q: 'Can you play offline?', a: 'Yes, in local mode: the phone is passed around and the game works without a connection. Online games, Anime Grid and leaderboards need internet.' },
        { q: 'Can you play remotely with friends?', a: 'Yes, both Undercover and the quiz. Create an online game and share the 6-character code or the invite link: everyone plays on their own phone.' },
        { q: 'Which manga are in the game?', a: `${UNIVERSES.length} universes: ${universeList}, plus an all-universes mix.` },
        { q: 'Which phones is Shobukan available on?', a: 'iPhone (App Store) and Android (Google Play), in English and French.' },
      ],
    }

const art = import.meta.glob<{ default: ImageMetadata }>('../assets/universes/*.png', { eager: true })
const uArt = (id: string) => art[`../assets/universes/${id.replaceAll('_', '-')}.png`]!.default
const gridCols = ['naruto', 'one_piece', 'dragon_ball'].map((id) => UNIVERSES.find((u) => u.id === id)!)
// Raretés affichées dans la grille d'exemple (0 = ultra rare … 3 = commun), sans fausses réponses.
const gridTiers = [[0, 3, 1], [2, 1, 3], [3, 0, 2]]
const path = ROUTES.home[lang]
const medium = `home_${lang}`
const jsonLd = [organization(), website(), app(lang), faqPage(`${SITE}${path}#faq`, c.faq)]
---

<Base lang={lang} title={c.title} description={c.description} path={path} alternates={{ fr: ROUTES.home.fr, en: ROUTES.home.en }} jsonLd={jsonLd}>
  <div class="wrap stack">
    <!-- HERO : texte à gauche, éventail de cartes à droite -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"><Image src={summitArt} alt="" width={900} quality={60} loading="eager" /></div>
      <div class="hero-copy">
        <h1 class="display">{c.h1a} <span class="hl">{c.h1b}</span></h1>
        <p class="hero-lede"><strong>{c.lede}</strong> {c.lede2}</p>
        <StoreButtons lang={lang} medium={medium} note={false}>
          <a class="btn btn-ghost try" href={ROUTES.quiz[lang]}>{c.tryQuiz} <span aria-hidden="true">→</span></a>
        </StoreButtons>
        <ul class="trust">
          {c.trust.map((tr) => (
            <li>
              <span class="ti"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={tr.svg} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <span><b>{tr.t}</b><small>{tr.s}</small></span>
            </li>
          ))}
        </ul>
      </div>
      <div class="hero-art"><CardFan lang={lang} /></div>
    </section>

    <!-- BENTO : Undercover + fonctionnalités -->
    <section class="bento" id="modes">
      <article class="uc reveal">
        <Image class="uc-bg" src={rainArt} alt="" width={900} loading="lazy" />
        <div class="uc-body">
          <h2 class="display">{c.ucA}<br /><span class="hl">{c.ucB}</span></h2>
          <ul class="check">{c.ucList.map((li) => <li>{li}</li>)}</ul>
          <div class="uc-actions">
            <a class="btn btn-primary" href={ROUTES.undercover[lang]}>{c.ucCta}</a>
            <span class="chip">{c.ucChip}</span>
          </div>
        </div>
        <div class="words" aria-hidden="true">
          <span class="wcard w1"><small>{c.roles[0]}</small>{c.pair[0]}</span>
          <span class="wcard w2"><small>{c.roles[2]}</small>{c.pair[1]}</span>
          <span class="wcard w3"><small>{c.roles[3]}</small>{c.noWord}</span>
        </div>
      </article>
      <div class="feats">
        <div class="card feat reveal">
          <div><h3>{c.feats.online.t}</h3><p>{c.feats.online.s}</p></div>
          <div class="mock code" aria-hidden="true">{'K7P2QX'.split('').map((ch) => <span>{ch}</span>)}</div>
        </div>
        <div class="card feat reveal">
          <div><h3>{c.feats.local.t}</h3><p>{c.feats.local.s}</p></div>
          <div class="mock avatars" aria-hidden="true">
            <span class="avs">{['#ff3348', '#ffd21a', '#3a86ff', '#06d6a0', '#b16cff'].map((col, k) => <i style={`--c:${col}`}>{'SKALM'[k]}</i>)}</span>
            <small>{c.feats.local.players}</small>
          </div>
        </div>
        <div class="card feat reveal">
          <div><h3>{c.feats.packs.t}</h3><p>{c.feats.packs.s}</p></div>
          <div class="mock packs" aria-hidden="true">{c.feats.packs.cards.map((w) => <span>{w}</span>)}</div>
        </div>
      </div>
    </section>

    <!-- VITRINES -->
    <section class="shows">
      <figure class="show reveal">
        <div class="art a-quiz">
          <Image class="sbg" src={pagesArt} alt="" width={800} loading="lazy" />
          <p class="stitle">Otaku Quiz</p>
          <div class="mini">
            <span class="mq">{c.quizQ}</span>
            <span class="mo">2</span><span class="mo ok">3</span><span class="mo">4</span><span class="mo">5</span>
          </div>
          <Image class="obj o1" src={uArt('one_piece')} alt="" width={200} loading="lazy" />
          <Image class="obj o2" src={uArt('naruto')} alt="" width={160} loading="lazy" />
        </div>
        <figcaption><a href={c.shows[0].href}><b>{c.shows[0].capT}</b></a><span>{c.shows[0].capS}</span></figcaption>
      </figure>
      <figure class="show reveal">
        <div class="art a-grid">
          <Image class="sbg" src={slotArt} alt="" width={800} loading="lazy" />
          <p class="stitle">Anime Grid</p>
          <div class="grid-mock">
            <span class="corner"></span>
            {gridCols.map((u) => <span class="gh"><Image src={uArt(u.id)} alt="" width={64} height={64} loading="lazy" /></span>)}
            {c.crit.map((cr, r) => (
              <>
                <span class="gr">{cr}</span>
                {gridTiers[r].map((tier) => <span class={`gc t${tier}`}></span>)}
              </>
            ))}
          </div>
          <ul class="legend">{c.rare.map((r, i) => <li class={`t${i}`}>{r}</li>)}</ul>
        </div>
        <figcaption><b>{c.shows[1].capT}</b><span>{c.shows[1].capS}</span></figcaption>
      </figure>
      <figure class="show reveal">
        <div class="art a-exp">
          <Image class="exp-bg" src={mountainArt} alt="" width={700} loading="lazy" />
          <p class="stitle">{fr ? 'Mode Histoire' : 'Story Mode'}</p>
          <ol class="chapters">
            {c.chapters.map((ch, i) => <li class={i === 0 ? 'done' : i === 1 ? 'now' : 'lock'}><span>{i + 1}</span>{ch}</li>)}
          </ol>
        </div>
        <figcaption><b>{c.shows[2].capT}</b><span>{c.shows[2].capS}</span></figcaption>
      </figure>
    </section>

    <!-- UNE QUESTION -->
    <section class="panel tryq reveal">
      <div class="tq-copy">
        <h2 class="display">{c.tqTitle}</h2>
        <p>{c.quizSub}</p>
        <a class="btn btn-primary" href={ROUTES.quiz[lang]}>{c.quizCta}</a>
      </div>
      <div class="well"><QuickQuestion lang={lang} /></div>
    </section>

    <!-- UNIVERS -->
    <section class="univ">
      <div class="univ-head"><h2 class="display">{c.univTitle}</h2><p>{c.univSub}</p></div>
    </section>
  </div>
  <div class="marquee-wrap"><UniverseMarquee lang={lang} /></div>
  <div class="wrap stack">
    <!-- PRIX -->
    <section class="price-sec" id="prix">
      <h2 class="display">{c.priceTitleA} <span class="hl">{c.priceTitleB}</span></h2>
      <PricingPanel lang={lang} />
    </section>
  </div>

  <Faq items={c.faq} title={c.faqTitle} />
  <CtaBand lang={lang} medium={`${medium}_footer`} />
</Base>

<style>
  .stack { display: grid; gap: clamp(16px, 2.4vw, 28px); padding-top: 16px; }

  /* ---------- HERO : texte + éventail de cartes ---------- */
  .hero {
    position: relative; isolation: isolate;
    display: grid; gap: 28px; align-items: center;
    padding: clamp(24px, 5vw, 64px) 0 clamp(12px, 3vw, 32px);
  }
  @media (min-width: 900px) { .hero { grid-template-columns: 1.08fr 1fr; gap: 24px; min-height: 560px; } }
  /* Planche de manga très effacée en fond, fondue dans le noir */
  .hero-bg { position: absolute; z-index: -1; inset: -16px calc(-1 * var(--gutter)) 0; overflow: hidden; pointer-events: none; }
  .hero-bg :global(img) {
    position: absolute; right: 0; top: 0; width: min(900px, 100%); height: 100%; object-fit: cover; object-position: 50% 30%;
    opacity: 0.22; filter: grayscale(0.4);
    mask-image: radial-gradient(70% 75% at 70% 40%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 75% at 70% 40%, #000, transparent 75%);
  }
  .hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(40% 50% at 75% 45%, rgba(255, 51, 72, 0.16), transparent 70%),
      radial-gradient(rgba(255, 246, 230, 0.06) 1px, transparent 1.4px) 0 0 / 14px 14px;
    mask-image: linear-gradient(180deg, #000 60%, transparent);
    -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent);
  }
  .hero h1 { font-size: clamp(38px, 5.4vw, 72px); line-height: 1.08; }
  .hero h1 .hl { display: block; margin-top: 2px; }
  .hero-lede { color: var(--muted); font-size: clamp(16px, 1.5vw, 18px); margin: 26px 0 26px; max-width: 560px; }
  .hero-lede strong { color: var(--text); font-weight: 600; }
  .try { height: 100%; min-height: 54px; padding: 0 20px; font-size: 16px; border-radius: 14px; }
  .trust { list-style: none; margin: 30px 0 0; padding: 22px 0 0; border-top: 1px solid var(--border); display: grid; gap: 14px; grid-template-columns: 1fr; max-width: 640px; }
  @media (min-width: 560px) { .trust { grid-template-columns: repeat(3, 1fr); gap: 16px; } }
  .trust li { display: flex; align-items: center; gap: 11px; }
  .ti { width: 38px; height: 38px; flex: none; display: grid; place-items: center; border-radius: 11px; background: var(--brand-tint); border: 1px solid rgba(255, 51, 72, 0.25); color: var(--accent-hot); }
  .ti svg { width: 19px; height: 19px; }
  .trust b { display: block; font-family: var(--font-display); font-weight: 800; font-size: 15px; line-height: 1.25; }
  .trust small { display: block; color: var(--faint); font-size: 13px; line-height: 1.3; }
  .hero-art { position: relative; overflow-x: clip; overflow-y: visible; padding: 0 6px; }
  @media (max-width: 899px) { .hero-art { order: -1; margin: 0 auto -6px; width: 100%; max-width: 420px; } }

  /* ---------- BENTO ---------- */
  .bento { display: grid; gap: 12px; }
  @media (min-width: 1000px) { .bento { grid-template-columns: 1.15fr 1fr; gap: 16px; } }
  .uc { position: relative; overflow: hidden; border-radius: var(--radius-lg); border: 1px solid var(--border); min-height: 320px; display: grid; align-items: center; background: #0a0a0f; }
  @media (min-width: 640px) { .uc { grid-template-columns: 1.3fr 1fr; } }
  .uc-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35; }
  .uc::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(5, 5, 8, 0.96) 0%, rgba(5, 5, 8, 0.75) 60%, rgba(5, 5, 8, 0.4)); }
  .uc-body { position: relative; z-index: 2; padding: clamp(22px, 3vw, 32px); }
  .uc h2 { font-size: clamp(26px, 3vw, 36px); }
  .uc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 22px; }
  .words { position: relative; z-index: 2; display: grid; gap: 10px; justify-items: center; padding: 0 24px 24px; }
  @media (min-width: 640px) { .words { padding: 24px 28px 24px 0; } }
  .wcard {
    display: block; width: min(230px, 100%); text-align: left;
    background: var(--text); color: #120609; font-family: var(--font-display); font-weight: 800; font-size: 17px;
    padding: 10px 14px; border-radius: 12px; box-shadow: 0 12px 24px rgba(0, 0, 0, 0.45);
  }
  .wcard small { display: block; font-family: var(--font-body); font-weight: 500; font-size: 12px; color: #6b6474; }
  .w1 { transform: rotate(-3deg) translateX(-10px); }
  .w2 { transform: rotate(2deg) translateX(12px); box-shadow: 0 0 0 3px var(--accent), 0 12px 24px rgba(0, 0, 0, 0.45); }
