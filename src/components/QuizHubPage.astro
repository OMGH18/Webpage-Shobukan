---
import Base from '../layouts/Base.astro'
import UniverseGrid from './UniverseGrid.astro'
import CtaBand from './CtaBand.astro'
import Faq from './Faq.astro'
import quizFr from '../data/quiz-fr.json'
import quizEn from '../data/quiz-en.json'
import { SITE, UNIVERSES, quizPath, universeName, type Lang } from '../data/product'
import { ROUTES } from '../i18n/ui'
import { breadcrumbs, faqPage, webPage } from '../data/schema'

interface Props { lang: Lang }
const { lang } = Astro.props
const fr = lang === 'fr'
const counts = ((fr ? quizFr : quizEn) as { counts: Record<string, number> }).counts
const total = Math.floor(Object.values(counts).reduce((a, b) => a + b, 0) / 100) * 100
const path = ROUTES.quiz[lang]
const n = UNIVERSES.length

const c = fr
  ? {
      title: `Quiz manga gratuits : ${n} quiz anime en 5 questions`,
      description: `Quiz manga gratuits sans inscription : Naruto, One Piece, Dragon Ball, Jujutsu Kaisen et ${n - 4} autres. 5 questions par univers.`,
      eyebrow: 'Quiz manga gratuits',
      h1: 'Quel otaku es-tu ?',
      strong: 'Choisis ton manga et réponds à 5 questions, gratuitement et sans inscription.',
      rest: `${n} univers au choix. Quand tu as fini, défie tes amis avec ton score.`,
      crumb: 'Quiz manga',
      faqTitle: 'Les quiz en bref',
      faq: [
        { q: 'Les quiz manga sont-ils gratuits ?', a: 'Oui, tous les quiz de cette page sont gratuits et sans inscription. Chaque quiz compte 5 questions à choix multiple.' },
        { q: 'Où trouver plus de questions ?', a: `Dans l'app Shobukan, gratuite sur iPhone et Android : plus de ${total} questions sur ${n} univers manga, à jouer seul, à plusieurs sur un même téléphone ou en ligne.` },
        { q: 'Peut-on faire un quiz manga entre amis ?', a: "Oui. L'Otaku Quiz de Shobukan se joue jusqu'à 12 joueurs : chacun répond en secret sur son téléphone, ou on se passe un seul téléphone." },
      ],
      ctaTitle: `Plus de ${total} questions dans l’app.`,
      ctaBody: 'Joue seul, sur un seul téléphone avec tes potes ou en ligne jusqu’à 12 joueurs.',
    }
  : {
      title: `Free anime quizzes: ${n} manga quizzes in 5 questions`,
      description: `Free anime quizzes, no sign-up: Naruto, One Piece, Dragon Ball, Jujutsu Kaisen and ${n - 4} more. 5 questions per universe.`,
      eyebrow: 'Free anime quizzes',
      h1: 'What kind of otaku are you?',
      strong: 'Pick your anime and answer 5 questions, free and with no sign-up.',
      rest: `${n} universes to choose from. When you’re done, challenge your friends with your score.`,
      crumb: 'Anime quizzes',
      faqTitle: 'Quiz FAQ',
      faq: [
        { q: 'Are these anime quizzes free?', a: 'Yes, every quiz on this page is free and needs no sign-up. Each quiz has 5 multiple-choice questions.' },
        { q: 'Where can I find more questions?', a: `In the Shobukan app, free on iPhone and Android: over ${total} questions across ${n} manga universes, solo, on one phone with friends, or online.` },
        { q: 'Can I play an anime quiz with friends?', a: 'Yes. Shobukan’s Otaku Quiz supports up to 12 players: everyone answers in secret on their own phone, or you pass one phone around.' },
      ],
      ctaTitle: `${total}+ questions in the app.`,
      ctaBody: 'Play solo, on one phone with friends, or online with up to 12 players.',
    }

const jsonLd = [
  webPage(path, c.title, lang),
  breadcrumbs([{ name: 'Shobukan', path: ROUTES.home[lang] }, { name: c.crumb, path }]),
  {
    '@type': 'ItemList',
    name: c.crumb,
    itemListElement: UNIVERSES.map((u, i) => ({ '@type': 'ListItem', position: i + 1, name: `Quiz ${universeName(u, lang)}`, url: `${SITE}${quizPath(u, lang)}` })),
  },
  faqPage(`${SITE}${path}#faq`, c.faq),
]
---

<Base lang={lang} title={c.title} description={c.description} path={path} alternates={{ fr: ROUTES.quiz.fr, en: ROUTES.quiz.en }} jsonLd={jsonLd}>
  <section class="section hub">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head">
        <h1 class="display">{c.h1}</h1>
        <p class="lede"><strong>{c.strong}</strong> {c.rest}</p>
      </div>
      <UniverseGrid lang={lang} linkToQuiz />
    </div>
  </section>
  <Faq items={c.faq} title={c.faqTitle} />
  <CtaBand lang={lang} medium={`quiz_hub_${lang}_footer`} title={c.ctaTitle} body={c.ctaBody} />
</Base>

<style>
  .hub { overflow: hidden; }
  .glow {
    position: absolute; top: -30%; right: -10%; width: 800px; height: 800px; max-width: 120vw;
    background: radial-gradient(closest-side, rgba(227, 38, 61, 0.35), transparent);
    pointer-events: none;
  }
  .hub .wrap { position: relative; }
</style>
