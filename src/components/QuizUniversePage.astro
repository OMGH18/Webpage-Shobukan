---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Base from '../layouts/Base.astro'
import Quiz from './Quiz.astro'
import UniverseGrid from './UniverseGrid.astro'
import CtaBand from './CtaBand.astro'
import Faq from './Faq.astro'
import quizFr from '../data/quiz-fr.json'
import quizEn from '../data/quiz-en.json'
import { SITE, UNIVERSES, quizPath, universeName, type Lang, type Universe } from '../data/product'
import { ROUTES } from '../i18n/ui'
import { APP_ID, breadcrumbs, faqPage, webPage } from '../data/schema'

interface Props { lang: Lang; universe: Universe }
const { lang, universe: u } = Astro.props
const fr = lang === 'fr'
type QuizData = { questions: Record<string, { q: string; a: string; d: string[] }[]>; counts: Record<string, number> }
const data = (fr ? quizFr : quizEn) as QuizData
const questions = data.questions[u.id] ?? []
// Arrondi à la dizaine inférieure : reste vrai quand le contenu évolue.
const appCount = Math.floor((data.counts[u.id] ?? 0) / 10) * 10
const art = import.meta.glob<{ default: ImageMetadata }>('../assets/universes/*.png', { eager: true })
const img = art[`../assets/universes/${u.id.replaceAll('_', '-')}.png`]?.default

const name = universeName(u, lang)
const path = quizPath(u, lang)
const others = UNIVERSES.length - 1

const c = fr
  ? {
      title: `Quiz ${name} : 5 questions pour tester ta culture`,
      description: `Quiz ${name} gratuit en 5 questions, sans inscription. Teste ta culture puis défie tes amis : plus de ${appCount} questions dans l'app Shobukan.`,
      crumbsLabel: "Fil d'Ariane",
      hub: 'Quiz manga',
      ledeStrong: `Ce quiz ${name} gratuit compte 5 questions à choix multiple, sans inscription.`,
      ledeRest: `Réponds directement ci-dessous, puis défie tes amis : l'app Shobukan en contient plus de ${appCount} sur ${name}.`,
      moreEyebrow: 'Encore plus de quiz',
      moreTitle: 'Un autre manga ?',
      faqTitle: `Le quiz ${name} en bref`,
      faq: [
        { q: `Combien de questions compte ce quiz ${name} ?`, a: `Ce quiz ${name} compte 5 questions à choix multiple, de facile à moyen. L'app Shobukan en propose plus de ${appCount} sur ${name}, plus ${others} autres univers manga.` },
        { q: `Peut-on jouer au quiz ${name} entre amis ?`, a: "Oui. Dans l'app Shobukan, le quiz se joue seul, à plusieurs sur un même téléphone ou en ligne jusqu'à 12 joueurs, chacun sur son téléphone avec un code de partie." },
        { q: 'Le quiz est-il gratuit ?', a: "Oui, ce quiz est gratuit et sans inscription. L'app Shobukan est aussi gratuite sur iPhone et Android, avec des publicités." },
      ],
      ctaTitle: `Plus de ${appCount} questions ${name} t’attendent.`,
      ctaBody: 'Joue seul pour monter en grade, ou lance une partie avec tes amis sur un seul téléphone ou en ligne.',
    }
  : {
      title: `${name} Quiz: 5 questions to test your knowledge`,
      description: `Free ${name} quiz in 5 multiple-choice questions, no sign-up. Test yourself, then challenge your friends: ${appCount}+ questions in the Shobukan app.`,
      crumbsLabel: 'Breadcrumb',
      hub: 'Anime quizzes',
      ledeStrong: `This free ${name} quiz has 5 multiple-choice questions, no sign-up needed.`,
      ledeRest: `Answer right below, then challenge your friends: the Shobukan app has over ${appCount} ${name} questions.`,
      moreEyebrow: 'More quizzes',
      moreTitle: 'Another anime?',
      faqTitle: `${name} quiz FAQ`,
      faq: [
        { q: `How many questions are in this ${name} quiz?`, a: `This ${name} quiz has 5 multiple-choice questions, from easy to medium. The Shobukan app has over ${appCount} ${name} questions, plus ${others} other manga universes.` },
        { q: `Can I play the ${name} quiz with friends?`, a: 'Yes. In the Shobukan app, the quiz can be played solo, with friends on one phone, or online with up to 12 players, each on their own phone with a game code.' },
        { q: 'Is the quiz free?', a: 'Yes, this quiz is free and needs no sign-up. The Shobukan app is also free on iPhone and Android, with ads.' },
      ],
      ctaTitle: `${appCount}+ ${name} questions are waiting.`,
      ctaBody: 'Play solo to rank up, or start a game with friends on one phone or online.',
    }

const jsonLd = [
  webPage(path, c.title, lang),
  breadcrumbs([
    { name: 'Shobukan', path: ROUTES.home[lang] },
    { name: c.hub, path: ROUTES.quiz[lang] },
    { name: `Quiz ${name}`, path },
  ]),
  {
    '@type': 'Quiz',
    '@id': `${SITE}${path}#quiz`,
    name: fr ? `Quiz ${name}` : `${name} Quiz`,
    inLanguage: lang,
    about: { '@type': 'CreativeWork', name },
    provider: { '@id': APP_ID },
    hasPart: questions.map((qu) => ({
      '@type': 'Question',
      eduQuestionType: 'Multiple choice',
      text: qu.q,
      acceptedAnswer: { '@type': 'Answer', text: qu.a },
      suggestedAnswer: qu.d.map((t) => ({ '@type': 'Answer', text: t })),
    })),
  },
  faqPage(`${SITE}${path}#faq`, c.faq),
]
const style = `--c1:${u.colors[0]};--c2:${u.colors[1]};--c3:${u.colors[2]}`
---

<Base lang={lang} title={c.title} description={c.description} path={path} alternates={{ fr: quizPath(u, 'fr'), en: quizPath(u, 'en') }} jsonLd={jsonLd}>
  <section class="qhero" style={style}>
    <div class="halftone dots" aria-hidden="true"></div>
    <div class="wrap qhero-grid">
      <div>
        <nav class="crumbs" aria-label={c.crumbsLabel}><a href={ROUTES.home[lang]}>Shobukan</a> / <a href={ROUTES.quiz[lang]}>{c.hub}</a> / <span>{name}</span></nav>
        <h1 class="display">{fr ? `Quiz ${name}` : `${name} Quiz`}</h1>
        <p class="lede"><strong>{c.ledeStrong}</strong> {c.ledeRest}</p>
      </div>
      {img && <Image class="uart" src={img} alt="" width={360} loading="eager" />}
    </div>
  </section>

  <section class="section quiz-section">
    <div class="wrap narrow">
      <Quiz lang={lang} questions={questions} universeName={name} appCount={appCount} medium={`quiz_${lang}_${u.slug}`} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{c.moreEyebrow}</p>
        <h2 class="display">{c.moreTitle}</h2>
      </div>
      <UniverseGrid lang={lang} linkToQuiz exclude={u.id} />
    </div>
  </section>

  <Faq items={c.faq} title={c.faqTitle} />
  <CtaBand lang={lang} medium={`quiz_${lang}_${u.slug}_footer`} title={c.ctaTitle} body={c.ctaBody} />
</Base>

<style>
  .qhero {
    position: relative; overflow: hidden; isolation: isolate; margin: 16px max(var(--gutter), calc((100% - var(--wrap)) / 2 + var(--gutter))) 0; border-radius: var(--radius-lg); border: 1px solid var(--border); 
    padding: clamp(36px, 7vw, 80px) 0 clamp(40px, 7vw, 72px);
    background:
      radial-gradient(60% 90% at 85% 30%, color-mix(in srgb, var(--c2) 55%, transparent), transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--c3) 35%, var(--bg)), var(--bg));
  }
  .dots { position: absolute; inset: 0; opacity: 0.7; mask-image: linear-gradient(180deg, #000, transparent); }
  .qhero-grid { position: relative; display: grid; gap: 24px; align-items: center; }
  @media (min-width: 820px) { .qhero-grid { grid-template-columns: 1.5fr 1fr; } }
  .crumbs { font-size: 14px; color: var(--muted); margin-bottom: 18px; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--text); }
  .crumbs span { color: var(--text); }
  .uart { width: min(300px, 60vw); height: auto; justify-self: center; filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.5)); transform: rotate(-6deg); }
  @media (max-width: 819px) { .uart { width: 150px; justify-self: start; order: -1; } }
  .quiz-section { padding-top: 8px; }
  .narrow { max-width: 820px; }
  .qhero-grid { padding-inline: clamp(20px, 3.5vw, 48px); }
</style>
