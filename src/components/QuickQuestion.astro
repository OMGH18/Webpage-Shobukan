---
// Une seule question jouable directement sur l'accueil : un avant-goût du quiz.
import type { Lang } from '../data/product'
import { ROUTES } from '../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props
const fr = lang === 'fr'
const q = fr
  ? { label: 'Quiz Naruto', q: 'Qui a créé la technique du Rasengan ?', opts: ['Jiraiya', 'Minato Namikaze', 'Kakashi Hatake', 'Tobirama Senju'], ok: 1, good: 'Bien joué. Prêt pour les 4 suivantes ?', bad: 'Raté : c’est Minato Namikaze. Revanche ?', cta: 'Faire le quiz Naruto complet', href: '/quiz/naruto/' }
  : { label: 'Naruto quiz', q: 'Who created the Rasengan technique?', opts: ['Jiraiya', 'Minato Namikaze', 'Kakashi Hatake', 'Tobirama Senju'], ok: 1, good: 'Nice. Ready for 4 more?', bad: 'Wrong: it was Minato Namikaze. Rematch?', cta: 'Take the full Naruto quiz', href: '/en/quiz/naruto/' }
const hub = ROUTES.quiz[lang]
---

<div class="qq" data-good={q.good} data-bad={q.bad}>
  <p class="label">{q.label}</p>
  <p class="question">{q.q}</p>
  <div class="opts">
    {q.opts.map((o, i) => <button type="button" data-ok={i === q.ok ? '1' : undefined}>{o}</button>)}
  </div>
  <p class="msg" aria-live="polite"></p>
  <a class="btn btn-primary go" href={q.href}>{q.cta} →</a>
  <a class="all" href={hub}>{fr ? 'Ou choisis un autre manga' : 'Or pick another anime'}</a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.qq').forEach((box) => {
    const btns = Array.from(box.querySelectorAll<HTMLButtonElement>('button'))
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        if (box.dataset.done) return
        box.dataset.done = '1'
        const ok = b.dataset.ok === '1'
        btns.forEach((x) => {
          x.disabled = true
          if (x.dataset.ok === '1') x.classList.add('right')
        })
        if (!ok) b.classList.add('wrong')
        box.querySelector('.msg')!.textContent = ok ? box.dataset.good! : box.dataset.bad!
        box.classList.add('answered')
      }),
    )
  })
</script>

<style>
  .qq { position: relative; background: var(--surface-2); border: 1px solid var(--border-strong); border-radius: 14px; padding: 20px; box-shadow: var(--elev-2); }
  .label { display: inline-flex; align-items: center; gap: 6px; margin: 0 0 10px; color: var(--muted); font-size: 14px; font-weight: 500; }
  .label::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .question { font-size: 19px; font-weight: 650; line-height: 1.3; margin: 4px 0 16px; letter-spacing: -0.01em; }
  .opts { display: grid; gap: 8px; grid-template-columns: 1fr 1fr; }
  button {
    font: inherit; font-weight: 550; font-size: 15px; text-align: left; color: var(--text);
    background: var(--well); border: 1px solid var(--border-strong); border-radius: 10px;
    padding: 12px 14px; cursor: pointer; transition: border-color 0.15s, background 0.15s;
  }
  button:hover:not(:disabled) { border-color: var(--accent-hot); background: var(--brand-tint); }
  button:disabled { cursor: default; opacity: 0.45; }
  button.right { opacity: 1; background: rgba(60, 207, 142, 0.14); border-color: var(--good); }
  button.wrong { opacity: 1; background: rgba(255, 90, 106, 0.14); border-color: var(--bad); }
  .msg { min-height: 1.4em; font-weight: 600; margin: 14px 0 0; }
  .go { display: none; margin-top: 10px; }
  .answered .go { display: inline-flex; }
  .all { display: inline-block; margin-top: 12px; color: var(--muted); font-size: 14px; }
  .all:hover { color: var(--text); }
  @media (max-width: 420px) { .opts { grid-template-columns: 1fr; } }
</style>
