---
import { Image } from 'astro:assets'
import icon from '../assets/art/icon.png'
import { PUBLISHER, SOCIALS, UNIVERSES, quizPath, universeName, type Lang } from '../data/product'
import { ROUTES, t } from '../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props
const ui = t(lang)
const fr = lang === 'fr'
const otherLang: Lang = fr ? 'en' : 'fr'
const half = Math.ceil(UNIVERSES.length / 2)
---

<footer class="site-footer">
  <div class="red">
    <div class="wrap">
      <div class="head">
        <p class="title">{fr ? 'Le party game manga' : 'The manga party game'}</p>
        <p class="sub">Undercover · Otaku Quiz · Anime Grid · {fr ? 'Expédition' : 'Expedition'}</p>
      </div>
      <div class="cols">
        <nav aria-label={ui.footer.game}>
          <h2>{ui.footer.game}</h2>
          <a href={ROUTES.home[lang]}>{fr ? 'Accueil' : 'Home'}</a>
          <a href={ROUTES.undercover[lang]}>{fr ? "Règles d'Undercover" : 'Undercover rules'}</a>
          <a href={`${ROUTES.home[lang]}#modes`}>{ui.nav.modes}</a>
          <a href={ROUTES.pricing[lang]}>{ui.nav.pricing}</a>
          <a href={ROUTES.quiz[lang]}>{fr ? 'Tous les quiz' : 'All quizzes'}</a>
        </nav>
        <nav aria-label={ui.nav.quiz} class="quiz-col">
          <h2>{ui.nav.quiz}</h2>
          <div class="two">
            <div>{UNIVERSES.slice(0, half).map((u) => <a href={quizPath(u, lang)}>{universeName(u, lang)}</a>)}</div>
            <div>{UNIVERSES.slice(half).map((u) => <a href={quizPath(u, lang)}>{universeName(u, lang)}</a>)}</div>
          </div>
        </nav>
        <nav aria-label={ui.footer.help}>
          <h2>{ui.footer.help}</h2>
          <a href={`mailto:${PUBLISHER.email}`}>{ui.footer.contact}</a>
          <a href="/privacy/">{ui.footer.privacy}</a>
          <a href="/terms/">{ui.footer.terms}</a>
          <a href="/account-deletion/">{ui.footer.deletion}</a>
        </nav>
        <nav aria-label={ui.footer.follow}>
          <h2>{ui.footer.follow}</h2>
          <a href={SOCIALS.tiktokFr} rel="me">TikTok (FR)</a>
          <a href={SOCIALS.tiktokEn} rel="me">TikTok (EN)</a>
          <a href={SOCIALS.instagram} rel="me">Instagram</a>
        </nav>
      </div>
    </div>
  </div>
  <div class="wrap bottom">
    <a class="brand" href={ROUTES.home[lang]}>
      <Image src={icon} alt="" width={40} height={40} />
      <span>© 2026 {PUBLISHER.name}</span>
    </a>
    <a class="lang" href={ROUTES.home[otherLang]} hreflang={otherLang} lang={otherLang}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      {ui.langSwitch}
    </a>
  </div>
  <p class="wrap legal">{ui.footer.legal}</p>
</footer>

<style>
  .site-footer { margin-top: clamp(24px, 4vw, 48px); }
  .red { background: linear-gradient(160deg, #e3263d, #c41a31 60%, #a3142a); color: #fff; padding: 40px 0 44px; }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; margin-bottom: 30px; }
  .title { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: -0.03em; font-size: clamp(24px, 3vw, 30px); margin: 0; color: #fff; }
  .sub { margin: 0; font-size: 14px; color: rgba(255, 255, 255, 0.75); }
  .cols { display: grid; gap: 28px 24px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .cols { grid-template-columns: 1fr 1.6fr 1fr 1fr; } }
  .quiz-col { grid-column: 1 / -1; }
  @media (min-width: 900px) { .quiz-col { grid-column: auto; } }
  nav { display: grid; gap: 7px; align-content: start; }
  nav h2 { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); margin: 0 0 4px; }
  nav a { color: #fff; text-decoration: none; font-size: 15px; }
  nav a:hover { text-decoration: underline; color: #fff; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }
  .two div { display: grid; gap: 7px; align-content: start; }
  .bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 20px; padding-bottom: 6px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); text-decoration: none; font-size: 14px; }
  .brand img { width: 24px; height: 24px; border-radius: 6px; }
  .lang { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); text-decoration: none; font-size: 14px; }
  .lang svg { width: 16px; height: 16px; }
  .lang:hover { color: var(--text); }
  .legal { font-size: 12px; color: var(--faint); line-height: 1.6; margin: 10px auto 0; padding-bottom: 28px; }
</style>
