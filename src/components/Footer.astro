---
import { Image } from 'astro:assets'
import icon from '../assets/art/icon.png'
import wordmark from '../assets/brand/shobukan-wordmark.png'
import { PUBLISHER, SOCIALS, UNIVERSES, quizPath, universeName, type Lang } from '../data/product'
import { ROUTES, t } from '../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props
const ui = t(lang)
const fr = lang === 'fr'
const otherLang: Lang = fr ? 'en' : 'fr'
const half = Math.ceil(UNIVERSES.length / 2)
---

<footer class="site-footer">
  <div class="top">
    <div class="wrap">
      <div class="head">
        <a class="logo" href={ROUTES.home[lang]} aria-label="Shobukan"><Image src={icon} alt="" width={64} height={64} /><Image class="wm" src={wordmark} alt="" width={320} /></a>
        <p class="sub">{fr ? 'Le party game manga' : 'The manga party game'} · Undercover · Otaku Quiz · Anime Grid · {fr ? 'Mode Histoire' : 'Story Mode'}</p>
      </div>
      <div class="cols">
        <nav aria-label={ui.footer.game}>
          <h2>{ui.footer.game}</h2>
          <a href={ROUTES.home[lang]}>{fr ? 'Accueil' : 'Home'}</a>
          <a href={ROUTES.undercover[lang]}>{fr ? "Règles d'Undercover" : 'Undercover rules'}</a>
          <a href={`${ROUTES.home[lang]}#modes`}>{ui.nav.modes}</a>
          <a href={ROUTES.pricing[lang]}>{ui.nav.pricing}</a>
          <a href={ROUTES.quiz[lang]}>{fr ? 'Tous les quiz' : 'All quizzes'}</a>
        </nav>
        <nav aria-label={ui.nav.quiz} class="quiz-col">
          <h2>{ui.nav.quiz}</h2>
          <div class="two">
            <div>{UNIVERSES.slice(0, half).map((u) => <a href={quizPath(u, lang)}>{universeName(u, lang)}</a>)}</div>
            <div>{UNIVERSES.slice(half).map((u) => <a href={quizPath(u, lang)}>{universeName(u, lang)}</a>)}</div>
          </div>
        </nav>
        <nav aria-label={ui.footer.help}>
          <h2>{ui.footer.help}</h2>
          <a href={`mailto:${PUBLISHER.email}`}>{ui.footer.contact}</a>
          <a href={fr ? '/privacy/' : '/en/privacy/'}>{ui.footer.privacy}</a>
          <a href={fr ? '/terms/' : '/en/terms/'}>{ui.footer.terms}</a>
          <a href={fr ? '/account-deletion/' : '/en/account-deletion/'}>{ui.footer.deletion}</a>
        </nav>
        <nav aria-label={ui.footer.follow}>
          <h2>{ui.footer.follow}</h2>
          <a href={SOCIALS.tiktokFr} rel="me">TikTok (FR)</a>
          <a href={SOCIALS.tiktokEn} rel="me">TikTok (EN)</a>
          <a href={SOCIALS.instagram} rel="me">Instagram</a>
        </nav>
      </div>
    </div>
  </div>
  <div class="wrap bottom">
    <a class="brand" href={ROUTES.home[lang]}>
      <Image src={icon} alt="" width={40} height={40} />
      <span>© 2026 {PUBLISHER.name}</span>
    </a>
    <a class="lang" href={ROUTES.home[otherLang]} hreflang={otherLang} lang={otherLang}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      {ui.langSwitch}
    </a>
  </div>
  <p class="wrap legal">{ui.footer.legal}</p>
</footer>

<style>
  .site-footer { margin-top: clamp(24px, 4vw, 48px); border-top: 1px solid var(--border); background: var(--bg-2); position: relative; }
  .site-footer::before { content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: linear-gradient(90deg, transparent, var(--accent) 30%, var(--gold) 70%, transparent); opacity: 0.8; }
  .top {
    padding: 44px 0 36px;
    background: radial-gradient(rgba(255, 246, 230, 0.05) 1px, transparent 1.4px) 0 0 / 14px 14px;
  }
  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin-bottom: 32px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); }
  .logo img:not(.wm) { width: 36px; height: 36px; border-radius: 10px; }
  .logo :global(.wm) { height: 28px; width: auto; }
  .sub { margin: 0; font-size: 14px; color: var(--faint); }
  .cols { display: grid; gap: 28px 24px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .cols { grid-template-columns: 1fr 1.6fr 1fr 1fr; } }
  .quiz-col { grid-column: 1 / -1; }
  @media (min-width: 900px) { .quiz-col { grid-column: auto; } }
  nav { display: grid; gap: 8px; align-content: start; }
  nav h2 { font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--text); margin: 0 0 4px; }
  nav a { color: var(--muted); text-decoration: none; font-size: 15px; }
  nav a:hover { color: var(--text); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }
  .two div { display: grid; gap: 8px; align-content: start; }
  .bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 18px; padding-bottom: 6px; border-top: 1px solid var(--border); }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--faint); text-decoration: none; font-size: 14px; }
  .brand img { display: none; }
  .lang { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); text-decoration: none; font-size: 14px; }
  .lang svg { width: 16px; height: 16px; }
  .lang:hover { color: var(--text); }
  .legal { font-size: 12px; color: var(--faint); line-height: 1.6; margin: 10px auto 0; padding-bottom: 28px; }
</style>
