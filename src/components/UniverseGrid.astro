---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { UNIVERSES, quizPath, universeName, type Lang } from '../data/product'

interface Props {
  lang: Lang
  /** Lien vers les pages quiz de la langue. */
  linkToQuiz?: boolean
  exclude?: string
}
const { lang, linkToQuiz = false, exclude } = Astro.props
const art = import.meta.glob<{ default: ImageMetadata }>('../assets/universes/*.png', { eager: true })
const artFor = (id: string) => art[`../assets/universes/${id.replaceAll('_', '-')}.png`]?.default
const items = UNIVERSES.filter((u) => u.id !== exclude)
---

<ul class="universes">
  {items.map((u) => {
    const img = artFor(u.id)
    const style = `--c1:${u.colors[0]};--c2:${u.colors[1]};--c3:${u.colors[2]}`
    const inner = (
      <>
        {img && <Image src={img} alt="" width={160} height={160} loading="lazy" />}
        <span class="name">{universeName(u, lang)}</span>
        {linkToQuiz && <span class="go">Quiz →</span>}
      </>
    )
    return (
      <li style={style}>
        {linkToQuiz ? <a href={quizPath(u, lang)}>{inner}</a> : <div>{inner}</div>}
      </li>
    )
  })}
</ul>

<style>
  .universes {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 640px) { .universes { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 980px) { .universes { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; } }
  li > a, li > div {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end;
    aspect-ratio: 1 / 1.08;
    border-radius: 20px; padding: 14px;
    text-decoration: none; color: #fff;
    background:
      radial-gradient(90% 70% at 50% 30%, var(--c1) 0%, transparent 70%),
      linear-gradient(160deg, var(--c2), var(--c3));
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  li > a:hover { transform: translateY(-4px) rotate(-0.6deg); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45); }
  li img {
    position: absolute; top: 8%; left: 50%; transform: translateX(-50%);
    width: 62%; height: auto; filter: drop-shadow(0 10px 14px rgba(0, 0, 0, 0.35));
    transition: transform 0.25s ease;
  }
  li > a:hover img { transform: translateX(-50%) scale(1.07) rotate(4deg); }
  .name {
    position: relative; font-weight: 800; font-size: 15px; line-height: 1.2;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.55);
  }
  .go { position: relative; font-size: 12px; font-weight: 700; opacity: 0.9; margin-top: 2px; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5); }
  li > a::after, li > div::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, transparent 45%, rgba(0, 0, 0, 0.45));
  }
  .name, .go { z-index: 1; }
</style>
