---
export interface FaqItem { q: string; a: string }
interface Props { items: FaqItem[]; title: string; eyebrow?: string }
const { items, title, eyebrow = 'FAQ' } = Astro.props
---

<section class="section" id="faq">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <div class="faq">
      {items.map((it, i) => (
        <details open={i === 0}>
          <summary>{it.q}</summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
