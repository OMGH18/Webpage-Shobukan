---
// Barre de navigation fixe en bas de l'écran, sur mobile uniquement.
import { iosLink, androidLink, type Lang } from '../data/product'
import { ROUTES, t } from '../i18n/ui'

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props
const ui = t(lang)
const fr = lang === 'fr'
const home = ROUTES.home[lang]
const items = [
  { href: home, label: fr ? 'Accueil' : 'Home', icon: 'M3 11 12 4l9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9Z' },
  { href: ROUTES.quiz[lang], label: 'Quiz', icon: 'M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17.5v.5M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z' },
  null,
  { href: ROUTES.undercover[lang], label: 'Undercover', icon: 'M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z' },
  { href: ROUTES.pricing[lang], label: ui.nav.pricing, icon: 'M6 3h12l4 6-10 12L2 9l4-6Z' },
]
const active = (href: string) => (href === home ? path === home : path.startsWith(href))
---

<nav class="mnav" aria-label={ui.navLabel}>
  {items.map((it) =>
    it ? (
      <a href={it.href} aria-current={active(it.href) ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={it.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span>{it.label}</span>
      </a>
    ) : (
      <a class="dl" href="#download" data-ios={iosLink(lang)} data-android={androidLink('mobile_nav')} aria-label={ui.nav.download}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    ),
  )}
</nav>

<script>
  // Le bouton central ouvre directement le bon store selon le téléphone.
  const dl = document.querySelector<HTMLAnchorElement>('.mnav .dl')
  if (dl) {
    const ua = navigator.userAgent
    if (/iPhone|iPad|iPod/i.test(ua)) dl.href = dl.dataset.ios!
    else if (/Android/i.test(ua)) dl.href = dl.dataset.android!
  }
</script>

<style>
  .mnav {
    position: fixed; inset: auto 0 0 0; z-index: 60;
    display: grid; grid-template-columns: repeat(5, 1fr); align-items: center;
    height: calc(64px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom);
    background: rgba(15, 15, 17, 0.94); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--border);
  }
  a { display: grid; justify-items: center; gap: 3px; color: var(--faint); text-decoration: none; font-size: 11px; font-weight: 500; }
  a svg { width: 22px; height: 22px; }
  a[aria-current='page'] { color: var(--text); }
  .dl {
    justify-self: center; width: 52px; height: 40px; border-radius: 12px; place-items: center; display: grid;
    background: linear-gradient(180deg, var(--accent-hot), var(--accent)); color: #fff;
    box-shadow: 0 3px 0 var(--accent-deep), 0 6px 18px rgba(227, 38, 61, 0.45);
  }
  .dl svg { width: 22px; height: 22px; }
  @media (min-width: 900px) { .mnav { display: none; } }
  @media (max-width: 899px) { :global(body) { padding-bottom: calc(64px + env(safe-area-inset-bottom)); } }
</style>
