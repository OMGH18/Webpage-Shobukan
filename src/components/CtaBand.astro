---
import { Image } from 'astro:assets'
import shinobi from '../assets/art/shobukan-shinobi-back.png'
import StoreButtons from './StoreButtons.astro'
import type { Lang } from '../data/product'
import { t } from '../i18n/ui'

interface Props { lang: Lang; medium: string; title?: string; body?: string }
const { lang, medium, title, body } = Astro.props
const ui = t(lang)
---

<section class="section cta-section" id="download">
  <div class="wrap">
    <div class="band reveal">
      <div class="halftone dots" aria-hidden="true"></div>
      <div class="copy">
        <h2 class="display">{title ?? ui.cta.title}</h2>
        <p>{body ?? ui.cta.body}</p>
        <StoreButtons lang={lang} medium={medium} />
      </div>
      <Image class="ninja" src={shinobi} alt="" width={420} loading="lazy" />
    </div>
  </div>
</section>

<style>
  .cta-section { padding-top: 8px; }
  .band {
    position: relative; overflow: hidden;
    border-radius: var(--radius-lg); border: 1px solid rgba(227, 38, 61, 0.35);
    background:
      radial-gradient(70% 120% at 85% 30%, rgba(227, 38, 61, 0.55), transparent 65%),
      linear-gradient(135deg, #1a0a0e, #120609 60%, #0b0b0d);
    padding: clamp(28px, 5vw, 56px);
    display: grid; gap: 24px; align-items: center;
    box-shadow: var(--elev-2);
  }
  @media (min-width: 820px) { .band { grid-template-columns: 1.4fr 1fr; } }
  .dots { position: absolute; inset: 0; opacity: 0.8; mask-image: linear-gradient(90deg, transparent, #000); }
  .copy { position: relative; z-index: 1; }
  h2 { font-size: clamp(28px, 4vw, 44px); }
  p { color: #d4d4d8; font-size: 17px; margin: 14px 0 26px; max-width: 520px; }
  .ninja {
    position: relative; z-index: 1; justify-self: center;
    width: min(280px, 70%); height: auto;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.6));
  }
  @media (max-width: 819px) { .ninja { display: none; } }
</style>
