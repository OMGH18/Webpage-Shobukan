---
import { Image } from 'astro:assets'
import shinobi from '../assets/art/shobukan-shinobi-back.png'
import StoreButtons from './StoreButtons.astro'
import type { Lang } from '../data/product'
import { t } from '../i18n/ui'

interface Props { lang: Lang; medium: string; title?: string; body?: string }
const { lang, medium, title, body } = Astro.props
const ui = t(lang)
---

<section class="section cta-section" id="download">
  <div class="wrap">
    <div class="band reveal">
      <div class="halftone dots" aria-hidden="true"></div>
      <div class="copy">
        <h2 class="display">{title ?? ui.cta.title}</h2>
        <p>{body ?? ui.cta.body}</p>
        <StoreButtons lang={lang} medium={medium} />
      </div>
      <Image class="ninja" src={shinobi} alt="" width={420} loading="lazy" />
    </div>
  </div>
</section>

<style>
  .cta-section { padding-top: 24px; }
  .band {
    position: relative; overflow: hidden;
    border-radius: var(--radius-lg);
    background: radial-gradient(120% 140% at 85% 20%, #d12139 0%, #8e1626 42%, #3a0b16 100%);
    padding: clamp(32px, 6vw, 64px);
    display: grid; gap: 24px; align-items: center;
    box-shadow: var(--shadow);
  }
  @media (min-width: 820px) { .band { grid-template-columns: 1.4fr 1fr; } }
  .dots { position: absolute; inset: 0; opacity: 0.6; mask-image: linear-gradient(90deg, transparent, #000); }
  .copy { position: relative; z-index: 1; }
  h2 { font-size: clamp(30px, 5vw, 46px); }
  p { color: rgba(255, 255, 255, 0.85); font-size: 18px; margin: 16px 0 28px; max-width: 520px; }
  .ninja {
    position: relative; z-index: 1; justify-self: center;
    width: min(320px, 70%); height: auto;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.45));
  }
  @media (max-width: 819px) { .ninja { display: none; } }
</style>
